<Window x:Class="LaunchFlow.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unlock LaunchFlow" Width="500" Height="340" MinWidth="460" MinHeight="320"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#111A2A" Foreground="#E9F1FB" FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Assets/LaunchFlow.ico">
  <Grid Margin="28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <Image Source="pack://application:,,,/Assets/LaunchFlow.png" Width="40" Height="40" Margin="0,0,12,0"/>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Unlock LaunchFlow" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="Your local encrypted vault" Foreground="#91A1B7" FontSize="12"/>
      </StackPanel>
    </StackPanel>
    <TextBlock Grid.Row="1" Margin="0,16,0,12" Foreground="#A8BED6" TextWrapping="Wrap"
               Text="Enter your master password, or use Windows Hello if you enabled it. LaunchFlow cannot recover a forgotten password — you can reset the vault and start over."/>
    <PasswordBox x:Name="PasswordBox" Grid.Row="2" Height="38" Background="#0D1522" Foreground="White"
                 BorderBrush="#354358" Padding="10,8"/>
    <StackPanel Grid.Row="3" Margin="0,14,0,0">
      <Button x:Name="HelloButton" Content="Unlock with Windows Hello" Click="Hello_Click"
              HorizontalAlignment="Left" Padding="14,8" Margin="0,0,0,10"/>
      <TextBlock x:Name="StatusText" Foreground="#F87171" TextWrapping="Wrap"/>
    </StackPanel>
    <DockPanel Grid.Row="4">
      <Button DockPanel.Dock="Left" Content="Forgot password…" Click="Forgot_Click" Padding="12,8"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Width="90" Height="36" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/>
        <Button Content="Unlock" Width="100" Height="36" IsDefault="True"
                Style="{StaticResource PrimaryButton}" Click="Unlock_Click"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
