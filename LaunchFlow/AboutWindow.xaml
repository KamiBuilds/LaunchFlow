<Window x:Class="LaunchFlow.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About LaunchFlow" Width="480" Height="420" MinWidth="440" MinHeight="380"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#111A2A" Foreground="#E9F1FB" FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Assets/LaunchFlow.ico">
  <Grid Margin="28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <Image Source="pack://application:,,,/Assets/LaunchFlow.png" Width="56" Height="56" Margin="0,0,16,0"/>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="LaunchFlow" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock x:Name="VersionText" Text="Version" Foreground="#91A1B7" Margin="0,4,0,0"/>
      </StackPanel>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,22,0,0">
      <TextBlock TextWrapping="Wrap" Foreground="#C5D5E8" LineHeight="20"
                 Text="Open your websites on the right screens, sign in from a local encrypted vault, and run everything with one shortcut — including after Windows unlock."/>
      <TextBlock Margin="0,16,0,0" FontWeight="SemiBold" Text="On this PC"/>
      <TextBlock x:Name="DataPathText" Margin="0,6,0,0" Foreground="#91A1B7" TextWrapping="Wrap"/>
      <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Text="Privacy"/>
      <TextBlock Margin="0,6,0,0" Foreground="#91A1B7" TextWrapping="Wrap"
                 Text="Workflows and passwords stay in your encrypted local database. LaunchFlow does not upload your vault or credentials."/>
    </StackPanel>
    <DockPanel Grid.Row="2">
      <Button DockPanel.Dock="Left" Content="Open data folder" Click="OpenData_Click" Padding="14,8"/>
      <Button DockPanel.Dock="Right" Content="Close" IsDefault="True" IsCancel="True" Width="100" Height="36"
              HorizontalAlignment="Right" Click="Close_Click"/>
    </DockPanel>
  </Grid>
</Window>
