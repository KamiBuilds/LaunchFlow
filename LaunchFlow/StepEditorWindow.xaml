<Window x:Class="LaunchFlow.StepEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit step" Width="460" Height="340" MinWidth="420" MinHeight="300"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#111A2A" Foreground="#E9F1FB" FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Assets/LaunchFlow.ico">
  <Grid Margin="24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Workflow step" FontSize="20" FontWeight="SemiBold"/>
    <StackPanel Grid.Row="1" Margin="0,16,0,12">
      <TextBlock Text="Type" FontWeight="SemiBold"/>
      <ComboBox x:Name="TypeCombo" AutomationProperties.Name="Step action type" Margin="0,6,0,12" SelectedIndex="0">
        <ComboBoxItem Content="Navigate"/>
        <ComboBoxItem Content="Click"/>
        <ComboBoxItem Content="Fill"/>
        <ComboBoxItem Content="Wait"/>
        <ComboBoxItem Content="Press"/>
        <ComboBoxItem Content="AssertVisible"/>
        <ComboBoxItem Content="WaitForURL"/>
      </ComboBox>
      <TextBlock Text="Target (URL, CSS selector, key, or milliseconds)" FontWeight="SemiBold"/>
      <TextBox x:Name="TargetBox" AutomationProperties.Name="Step target or condition" Margin="0,6,0,12"/>
      <TextBlock Text="Value (for Fill)" FontWeight="SemiBold"/>
      <TextBox x:Name="ValueBox" AutomationProperties.Name="Non-secret fill value" Margin="0,6,0,12" ToolTip="Never put passwords, tokens or one-time codes in workflow steps. Use the encrypted vault for login."/>
      <TextBlock Text="Never store passwords or access tokens as Fill values. Use the Passwords tab."
                 Foreground="#A6BFD2" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
      <TextBlock Text="Description (optional)" FontWeight="SemiBold"/>
      <TextBox x:Name="DescriptionBox" Margin="0,6,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" Width="90" Height="36" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/>
      <Button Content="Save" Width="90" Height="36" Style="{StaticResource PrimaryButton}"
              IsDefault="True" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
