<Window x:Class="LaunchFlow.StepEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit step" Width="520" Height="535" MinWidth="470" MinHeight="480"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="#0D1725" Foreground="#EEF6FA" FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Assets/LaunchFlow.ico">
  <Grid Margin="24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="Heading" Text="Workflow step" FontSize="20" FontWeight="SemiBold"/>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,10"><StackPanel Margin="0,0,10,0">
      <TextBlock x:Name="TypeLabel" Text="Type" FontWeight="SemiBold"/>
      <ComboBox x:Name="TypeCombo" AutomationProperties.Name="Step action type" Margin="0,6,0,12" SelectedIndex="0">
        <ComboBoxItem Content="Navigate" Tag="Navigate"/>
        <ComboBoxItem Content="Click" Tag="Click"/>
        <ComboBoxItem Content="Fill" Tag="Fill"/>
        <ComboBoxItem Content="Wait" Tag="Wait"/>
        <ComboBoxItem Content="Press" Tag="Press"/>
        <ComboBoxItem Content="AssertVisible" Tag="AssertVisible"/>
        <ComboBoxItem Content="WaitForURL" Tag="WaitForURL"/>
      </ComboBox>
      <TextBlock x:Name="TargetLabel" Text="Target (URL, CSS selector, key, or milliseconds)" FontWeight="SemiBold"/>
      <TextBox x:Name="TargetBox" AutomationProperties.Name="Step target or condition" Margin="0,6,0,12"/>
      <TextBlock x:Name="ValueLabel" Text="Value (for Fill)" FontWeight="SemiBold"/>
      <TextBox x:Name="ValueBox" AutomationProperties.Name="Non-secret fill value" Margin="0,6,0,12" ToolTip="Never put passwords, tokens or one-time codes in workflow steps. Use the encrypted vault for login."/>
      <TextBlock x:Name="SecretsWarning" Text="Never store passwords or access tokens as Fill values. Use the Passwords tab."
                 Foreground="#ACC6D4" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
      <TextBlock x:Name="DescriptionLabel" Text="Description (optional)" FontWeight="SemiBold"/>
      <TextBox x:Name="DescriptionBox" Margin="0,6,0,0"/>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Content="Cancel" Width="90" Height="36" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click"/>
      <Button x:Name="SaveButton" Content="Save" Width="90" Height="36" Style="{StaticResource PrimaryButton}"
              IsDefault="True" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
