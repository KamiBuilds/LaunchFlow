                  <Button Content="Export redacted support report" Click="ExportDiagnostics_Click" Padding="14,9"
                          HorizontalAlignment="Left" Margin="0,10,0,0"
                          ToolTip="Save a local report containing only version, timestamps and redacted event codes"
                          AutomationProperties.Name="Export redacted diagnostic report"/>
                  <TextBlock x:Name="UpdateStatusLabel" Foreground="#6EE7D7" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
        </ScrollViewer></TabItem><TabItem Header="Shortcuts"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28" MaxWidth="750" HorizontalAlignment="Left"><TextBlock Text="Keyboard shortcut" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="LaunchFlow always listens for this shortcut while running, including when hidden in the system tray. Press a combination containing Ctrl, Alt or Shift." TextWrapping="Wrap" Foreground="#A9BBD3" Margin="0,0,0,20"/><StackPanel Orientation="Horizontal"><TextBox x:Name="ShortcutBox" IsReadOnly="True" Width="210" Text="Ctrl+M" Margin="0,0,14,0"/><Button x:Name="CaptureButton" Content="Change shortcut" Click="CaptureShortcut_Click"/></StackPanel><TextBlock x:Name="ShortcutHelpLabel" Text="Default: Ctrl+M" Margin="0,11,0,0" Foreground="#86DBF3" TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem><TabItem Header="Advanced"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28" MaxWidth="790" HorizontalAlignment="Left"><TextBlock Text="Advanced sign-in options" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBlock Text="These optional fields apply to the currently selected website. Most websites do not require changing them." Foreground="#ABBDD3" TextWrapping="Wrap" Margin="0,0,0,14"/><Expander Header="Advanced settings (only if the website needs them)" Foreground="#D9F1FC" Background="#18283C" Padding="10" Margin="0,0,0,12" IsExpanded="True">
                  <StackPanel Margin="4,10,4,4">
                    <TextBlock Text="Trusted username page address (HTTPS; blank = start URL)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="CredentialOriginBox" Margin="0,0,0,11" ToolTip="Example: https://login.example.com"/>
                    <TextBlock Text="Trusted password page address (HTTPS; only if different)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PasswordOriginBox" Margin="0,0,0,11" ToolTip="If your employer redirects to a different SSO domain, set its exact HTTPS origin here."/>
                    <Grid Margin="0,0,0,11">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0"><TextBlock Text="Username field (CSS)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="UsernameSelectorBox"/></StackPanel>
                      <StackPanel Grid.Column="2"><TextBlock Text="Password field (CSS)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PasswordSelectorBox"/></StackPanel>
                    </Grid>
                    <TextBlock Text="Next button after username (for two-page logins)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="UsernameContinueBox" Margin="0,0,0,11"/>
                    <TextBlock Text="Final sign-in button (CSS; blank means click manually)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="SubmitSelectorBox" Margin="0,0,0,11"/>
                    <TextBlock Text="Visible element after successful login (CSS, optional)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="LoginSuccessSelectorBox" Margin="0,0,0,11"/>
                  </StackPanel>
                </Expander>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="Sign-in timeout (seconds)" Foreground="#9DAFC5" VerticalAlignment="Center" Margin="0,0,15,0"/>
                  <TextBox x:Name="LoginWaitBox" Width="75" Text="60"/>
                  <TextBlock Text="MFA always stays under your control." Foreground="#96AFC3" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
              </StackPanel></ScrollViewer></TabItem><TabItem Header="Import / Export"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28" MaxWidth="790" HorizontalAlignment="Left"><TextBlock Text="Move to another PC" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBlock Text="Transfer websites and saved logins using a password-protected file." Foreground="#B3C6DD" TextWrapping="Wrap" Margin="0,0,0,16"/><CheckBox x:Name="IncludePasswordsCheck" Content="Include saved login passwords in encrypted export" IsChecked="True"/><Button Content="Export encrypted configuration…" Click="Export_Click" Width="275" HorizontalAlignment="Left" Margin="0,12,0,15"/><Button Content="Import configuration…" Click="Import_Click" Width="275" HorizontalAlignment="Left"/>
<TextBlock Text="Import replaces existing websites after confirmation. Keep your export password safe." Foreground="#E6B6A0" TextWrapping="Wrap" Margin="0,15,0,12"/>
<Border Background="#18283C" CornerRadius="10" Padding="14,12" Margin="0,8,0,0"><StackPanel>
<TextBlock Text="Older workspace groups" FontWeight="SemiBold" Foreground="#D7E8F5" Margin="0,0,0,6"/>
<TextBlock Text="Earlier LaunchFlow versions could save named workspace groups. Those encrypted records are still kept and still import/export with your configuration. The main screen now focuses on websites: enable the sites you need and use Run all. Named workspace edit controls stay hidden so they do not compete with the websites list." TextWrapping="Wrap" Foreground="#A9C0D3" FontSize="12"/>
</StackPanel></Border></StackPanel></ScrollViewer></TabItem></TabControl></TabItem></TabControl></Grid></Window>
