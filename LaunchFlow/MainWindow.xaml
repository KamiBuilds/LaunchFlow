<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" x:Class="LaunchFlow.MainWindow" Title="LaunchFlow — Website workspace automation" Width="1230" Height="820" MinWidth="920" MinHeight="640" WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="True" WindowStartupLocation="CenterScreen" Background="#0B1220" Foreground="#E9F1FB" FontFamily="Segoe UI" FontSize="13" Closing="OnClosing" Closed="OnClosed" Loaded="OnLoaded" StateChanged="Window_StateChanged" Icon="pack://application:,,,/Assets/LaunchFlow.ico" PreviewKeyDown="Window_PreviewKeyDown">
  <!-- WPF WindowChrome keeps native drag, double-click maximize, and resize while
       allowing all app navigation to occupy the actual title-bar region. -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="49" ResizeBorderThickness="7"
                        GlassFrameThickness="0" CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Foreground" Value="#A0B4CC"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#9DAFC5"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="TopNavStyle" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#AEBFD2"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,3,0"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="NavFace" Background="{TemplateBinding Background}"
                  BorderBrush="Transparent" BorderThickness="0,0,0,2" CornerRadius="6,6,0,0" Padding="12,10">
            <ContentPresenter ContentSource="Content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="NavFace" Property="Background" Value="#20364C"/>
              <Setter TargetName="NavFace" Property="BorderBrush" Value="#6EE7D7"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="NavFace" Property="Background" Value="#2B4057"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="WorkflowEnabledToggle" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border x:Name="Track" Width="38" Height="21" CornerRadius="11" Background="#435369">
              <Ellipse x:Name="Thumb" Width="15" Height="15" Fill="#E1E9F3"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"/>
            </Border>
            <TextBlock x:Name="SwitchLabel" Text="Disabled" Foreground="#9DAFC6"
                       FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="#6EE7D7"/>
              <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
              <Setter TargetName="Thumb" Property="Fill" Value="#101827"/>
              <Setter TargetName="SwitchLabel" Property="Text" Value="Enabled"/>
              <Setter TargetName="SwitchLabel" Property="Foreground" Value="#E9F5F5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="TitleBarButton" TargetType="Button">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#C5D5E6"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonFace" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ButtonFace" Property="Background" Value="#283B50"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="CloseFace" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="CloseFace" Property="Background" Value="#B82C38"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid Background="#0B1220">
    <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <!-- Actual custom WINDOW TITLE BAR: no second toolbar below native caption. -->
    <Border Grid.Row="0" Background="#101827" BorderBrush="#294254"
            BorderThickness="0,0,0,1" Padding="18,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="49"/><RowDefinition Height="43"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="22"/>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="32" Height="32" CornerRadius="9" Background="#203854" Padding="6" Margin="0,0,10,0">
              <Image Source="pack://application:,,,/Assets/LaunchFlow.ico" Stretch="Uniform"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="LaunchFlow" FontSize="16" FontWeight="Bold" Foreground="#F2F9FC"/>
              <TextBlock Text="WORKSPACE AUTOMATION" FontSize="9" FontWeight="SemiBold"
                         Foreground="#87ABBD" Margin="0,2,0,0"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
            <RadioButton x:Name="WorkflowsNav" Content="Websites" GroupName="TopNavigation"
                         Style="{StaticResource TopNavStyle}" IsChecked="True" Click="TopNavigation_Click"
                         shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <RadioButton x:Name="SettingsNav" Content="Settings" GroupName="TopNavigation"
                         Style="{StaticResource TopNavStyle}" Click="TopNavigation_Click"
                         shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          </StackPanel>
          <Border Grid.Column="4" Background="#223950" BorderBrush="#29425D"
                  BorderThickness="1" CornerRadius="9" Padding="10,5" VerticalAlignment="Center"
                  Margin="0,0,12,0">
            <TextBlock x:Name="HeaderVersionLabel" Text="v0.7.22" Foreground="#79E7D6"
                       FontSize="11" FontWeight="SemiBold"/>
          </Border>
          <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Stretch">
            <Button Content="─" ToolTip="Minimize" Style="{StaticResource TitleBarButton}"
                    Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button x:Name="TitlebarMaxButton" Content="□" ToolTip="Maximize"
                    Style="{StaticResource TitleBarButton}" Click="MaximizeRestore_Click"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            <Button Content="×" ToolTip="Close" Style="{StaticResource TitleBarCloseButton}"
                    Click="WindowClose_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          </StackPanel>
        </Grid>
        <!-- Clear groups: create/save on the left, run controls in the middle,
             help on the right. Preserve the existing button names and handlers. -->
        <Grid Grid.Row="1" Margin="0,5,0,7">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="+ Add website" Click="AddWorkflow_Click"
                  ToolTip="Choose a website, browser and screen" Padding="15,8"
                  Margin="0,0,12,0" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="SaveChangesButton" Content="Save changes" Click="Save_Click"
                    ToolTip="Save website and application settings in the encrypted vault"
                    Padding="14,8" Margin="0,0,10,0"/>
            <TextBlock x:Name="SaveStatusLabel" Text="All changes saved" Foreground="#85C9B9"
                       FontSize="11" VerticalAlignment="Center" MaxWidth="148"
                       TextTrimming="CharacterEllipsis" Margin="0,0,16,0"
                       AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
          <Border Grid.Column="2" BorderBrush="#355068" BorderThickness="1,0,0,0"
                  Padding="14,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="RunAllButton" Content="▶ Run all" ToolTip="Open all enabled websites"
                      Click="Run_Click" Style="{StaticResource PrimaryButton}"
                      AutomationProperties.Name="Run all enabled websites"
                      Padding="17,8" Margin="0,0,8,0"/>
              <Button x:Name="StopButton" Content="■ Stop" Click="Stop_Click"
                      IsEnabled="False" Padding="13,8" Margin="0,0,0,0"/>
              <Button x:Name="RetryVaultLockButton" Content="Retry vault lock"
                      Click="LockPasswords_Click" Visibility="Collapsed"
                      AutomationProperties.Name="Retry browser cleanup and vault lock"
                      Padding="12,8" Margin="8,0,0,0"/>
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="Getting started" Click="Help_Click"
                    ToolTip="Step-by-step guide" Padding="11,8" Margin="0,0,7,0"/>
            <Button Content="About" Click="About_Click" Padding="11,8" Margin="0"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
<TabControl x:Name="MainTabs" Grid.Row="1" Margin="12,10,12,12" SelectionChanged="MainTabs_SelectionChanged">
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <Border Background="#141B29" BorderBrush="#26364C" BorderThickness="1" CornerRadius="8">
            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
          </Border>
        </ControlTemplate>
      </TabControl.Template><TabItem Header="Websites"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="274" x:Name="SidebarColumn"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button x:Name="SidebarToggleButton" Grid.Column="1" Content="❮" Click="ToggleSidebar_Click" ToolTip="Show or hide the website list" Width="31" Height="42" VerticalAlignment="Top" Margin="0,3,0,0" Padding="2" Background="#203854"/><Border Grid.Column="0" Background="#141B29" CornerRadius="13" Padding="17" x:Name="SidebarPanel" BorderBrush="#263C50" BorderThickness="1">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="YOUR WEBSITES" FontWeight="SemiBold" FontSize="12"
                       Foreground="#92B4C6" Margin="1,0,0,5"/>
            <TextBlock Text="Select a website to edit or test. Run all opens every enabled website."
                       Foreground="#A8BECD" FontSize="11" TextWrapping="Wrap" Margin="1,0,0,10"/>
            <Border CornerRadius="8" Background="#18283C" Padding="9,6"
                    HorizontalAlignment="Left" Margin="0,0,0,16">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="#6EE7D7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="WorkflowStatusLabel" Text="Ready" Foreground="#91EBDD"
                           FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Workflow status"/>
              </StackPanel>
            </Border>
            <!-- Compatibility-only controls for saved workspace records.
                 This panel never appears or takes focus. Retain existing encrypted
                 workspace data and event contracts for import/review compatibility. -->
            <StackPanel x:Name="LegacyWorkspacePanel" Visibility="Collapsed"
                        IsHitTestVisible="False" Focusable="False">
              <TextBlock x:Name="WorkspaceHeading" Text="WORKSPACE PROFILES"/>
              <ComboBox x:Name="WorkspaceCombo" IsEditable="False" DisplayMemberPath="Name"
                        SelectionChanged="WorkspaceCombo_SelectionChanged"/>
              <TextBox x:Name="WorkspaceNameBox" TextChanged="WorkspaceNameBox_TextChanged"/>
              <Button x:Name="SaveWorkspaceButton" Content="Save" Click="SaveWorkspace_Click"/>
              <Button x:Name="PreviewWorkspaceButton" Content="Preview" Click="PreviewWorkspace_Click"/>
              <Button x:Name="RunWorkspaceButton" Content="Run workspace" Click="RunWorkspace_Click"/>
            </StackPanel>

          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="DuplicateWorkflowButton" Content="Duplicate" Click="DuplicateWorkflow_Click" IsEnabled="False"/>
            <Button x:Name="DeleteWorkflowButton" Content="Delete" Click="DeleteWorkflow_Click" IsEnabled="False" Margin="0"/>
          </StackPanel>
          <ListBox x:Name="WorkflowList" SelectionChanged="WorkflowList_SelectionChanged"
                   DisplayMemberPath="Name" Padding="5" FontSize="13" Background="Transparent"
                   AutomationProperties.Name="Saved website workflows"/>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Background="#141B29" CornerRadius="13" Padding="22" BorderBrush="#263C50" BorderThickness="1">
        <Grid>
        <ScrollViewer x:Name="WorkflowEditorScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel x:Name="EditorPanel">
            <Grid Height="40" Margin="0,0,0,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="1. Website details" FontWeight="Bold" FontSize="20" VerticalAlignment="Center"/>
              <CheckBox Grid.Column="1" x:Name="EnabledCheck" Style="{StaticResource WorkflowEnabledToggle}"
                        AutomationProperties.Name="Enable or disable this workflow"
                        ToolTip="Choose whether this website runs with Run all" VerticalAlignment="Center" Margin="0,0,2,0"/>
            </Grid>
            <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NameBox" Margin="0,0,0,10" AutomationProperties.Name="Workflow name"/>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0"><TextBlock Text="Login / start URL" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="StartUrlBox" ToolTip="Full URL, including https://" AutomationProperties.Name="Website start URL"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Browser" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="BrowserCombo" DropDownOpened="BrowserCombo_DropDownOpened"
                          ToolTip="Only browsers detected on this computer are offered for automatic login."
                          AutomationProperties.Name="Installed browser"/></StackPanel>
            </Grid>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Screen" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="MonitorCombo" SelectionChanged="MonitorCombo_SelectionChanged" AutomationProperties.Name="Screen"/>
              </StackPanel>
              <Button x:Name="RunSelectedButton" Grid.Column="2" Content="▶ Test this site" Click="RunSelected_Click" ToolTip="Save changes and run only this website" VerticalAlignment="Bottom" Margin="0"/>
            </Grid>
            <!-- Legacy control retained for settings compatibility. Old destinations migrate to steps. -->
            <TextBox x:Name="DestinationUrlBox" Visibility="Collapsed"/>
            <Border Background="#18283C" CornerRadius="8" Padding="12,9" Margin="0,2,0,16">
              <TextBlock Text="A website opens without extra actions. Want it to click buttons automatically? Use Record clicks below, then test the site."
                         Foreground="#C3DEDF" TextWrapping="Wrap" FontSize="12"/>
            </Border>
            <StackPanel Margin="0,0,0,11">
               <TextBlock Text="2. Recorded actions (optional)" FontSize="16" FontWeight="SemiBold"
                          Foreground="#D9E7F4" Margin="0,0,0,5"/>
               <TextBlock Text="Only needed when a website should click buttons or links for you. Recorded actions do not include typed passwords."
                          Foreground="#9FB9CB" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,9"/>
               <WrapPanel Margin="0,0,0,4">
                 <Button x:Name="TeachButton" Content="● Record clicks" Click="RecordSteps_Click"
                         Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Teach by clicking"
                         ToolTip="Record safe browser clicks for the selected website" Margin="0,0,8,6"/>
                 <Button x:Name="RepairButton" Content="Fix sign-in" Click="RepairLogin_Click" Margin="0,0,8,6"
                         ToolTip="Review and repair a website's sign-in sequence"/>
                 <Button Content="Advanced sign-in…" Click="OpenWebsiteAdvancedSignIn_Click"
                         ToolTip="Open advanced selector and trusted-origin settings for this website" Margin="0,0,8,6"/>
               </WrapPanel>
               <Expander Header="More actions (advanced): pages, waits and editing"
                         Foreground="#BBD3E4" Background="#192B3E" Padding="9">
                 <WrapPanel Margin="4,8,3,0">
                   <Button Content="+ Page" Click="AddPage_Click" ToolTip="Open another website/page after sign-in" Margin="0,0,6,6"/>
                   <Button Content="+ Action" Click="AddStep_Click" Margin="0,0,6,6"/>
                   <Button Content="Edit selected" Click="EditStep_Click" Margin="0,0,6,6" ToolTip="Edit one selected action; double-click also opens the editor"/>
                   <Button Content="Wait +1s" Click="QuickWaitStep_Click" Margin="0,0,6,6" ToolTip="Insert a one-second pause after a slow page load"/>
                   <Button Content="Select all" Click="SelectAllSteps_Click" Margin="0,0,6,6"/>
                   <Button Content="Delete selected" Click="RemoveStep_Click" Margin="0,0,0,6"/>
                 </WrapPanel>
               </Expander>
             </StackPanel>
            <ListBox x:Name="StepList" MinHeight="128" Height="180" FontSize="13" SelectionMode="Extended" MouseDoubleClick="EditStep_Click"
                     AutomationProperties.Name="Workflow steps after sign-in"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
              <Button Content="↑ Up" Click="MoveStepUp_Click"/>
              <Button Content="↓ Down" Click="MoveStepDown_Click" Margin="0"/>
            </StackPanel>
            <TextBlock Text="3. Test: click Test this site above (it saves changes first). Run all opens every enabled website. Actions run in the order listed." TextWrapping="Wrap" Foreground="#96AFC3" FontSize="11" Margin="0,8,0,0"/>
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="WorkflowEmptyState" Visibility="Visible" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Margin="16">
          <StackPanel HorizontalAlignment="Center">
            <Border Width="76" Height="76" Background="#203854" CornerRadius="18" HorizontalAlignment="Center" Margin="0,0,0,18">
              <TextBlock Text="+" FontSize="48" FontWeight="Light" Foreground="#6EE7D7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="EmptyStateHeading" Text="No websites yet" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock x:Name="EmptyStateDescription" Text="LaunchFlow opens websites on your chosen screen and can perform recorded actions. Start with one website. Login and automation are optional." Foreground="#A9BDD4" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" Margin="0,0,0,22"/>
            <Border Background="#192B3E" BorderBrush="#2D4B60" BorderThickness="1"
                     CornerRadius="10" Padding="15,12" Margin="0,0,0,18" MaxWidth="470">
               <StackPanel>
                 <TextBlock Text="START HERE · 3 EASY STEPS" FontSize="11" FontWeight="SemiBold"
                            Foreground="#6EE7D7" Margin="0,0,0,8"/>
                 <TextBlock Text="1. Add a website, browser and screen." Foreground="#D1E1F0" Margin="0,0,0,5"/>
                 <TextBlock Text="2. Optionally save a login or record clicks." Foreground="#D1E1F0" Margin="0,0,0,5"/>
                 <TextBlock Text="3. Test this site. Later, use Run all for multiple sites." Foreground="#D1E1F0" TextWrapping="Wrap"/>
               </StackPanel>
             </Border>
             <Button x:Name="CreateFirstWorkflowButton" Content="+ Add your first website"
                     Click="AddWorkflow_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center"
                     MinWidth="230" Padding="20,12" Margin="0,0,0,8"/>
             <Button Content="Show the step-by-step guide" Click="Help_Click" HorizontalAlignment="Center" Padding="14,7"/>
          </StackPanel>
        </Grid>
        </Grid>
      </Border>
    </Grid>
    </TabItem><TabItem Header="Settings">
      <TabControl x:Name="SettingsTabs" Margin="0" Background="#111A2A" TabStripPlacement="Left" BorderThickness="0" Padding="8" SelectionChanged="SettingsTabs_SelectionChanged">
        <TabControl.Resources>
          <Style TargetType="TabItem">
            <Setter Property="MinWidth" Value="175"/>
            <Setter Property="Foreground" Value="#AFC3D8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
            <Setter Property="Template"><Setter.Value>
              <ControlTemplate TargetType="TabItem">
                <Border x:Name="NavItem" Background="{TemplateBinding Background}"
                        BorderBrush="Transparent" BorderThickness="3,0,0,0"
                        CornerRadius="5" Padding="{TemplateBinding Padding}">
                  <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="NavItem" Property="Background" Value="#223950"/>
                    <Setter TargetName="NavItem" Property="BorderBrush" Value="#6EE7D7"/>
                    <Setter Property="Foreground" Value="White"/>
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="NavItem" Property="Background" Value="#29425D"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value></Setter>
          </Style>
        </TabControl.Resources>
        <TabItem Header="General"><ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock Text="Choose a category from the list on the left. Save website and app settings with Save changes in the title bar."
                       Foreground="#AEC5DD" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,22"/>
            <TextBlock Text="Language / Taal" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,7"/>
            <ComboBox x:Name="LanguageCombo" Width="200" HorizontalAlignment="Left"
                      AutomationProperties.Name="Application language">
              <ComboBoxItem Content="System default" Tag="auto"/>
              <ComboBoxItem Content="English" Tag="en"/>
              <ComboBoxItem Content="Nederlands" Tag="nl"/>
            </ComboBox>
            <TextBlock Text="Navigation and website controls support English and Dutch. Other text remains English."
                       Foreground="#A1BCD2" TextWrapping="Wrap" Margin="0,7,0,16"/>
            
          </StackPanel>
        </ScrollViewer></TabItem>
        <TabItem Header="Passwords"><ScrollViewer VerticalScrollBarVisibility="Auto" Background="#111A2A"><StackPanel Margin="28" MaxWidth="840" HorizontalAlignment="Left"><TextBlock Text="Passwords for this website" FontSize="24" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock Text="One master-password unlock lasts one hour, even if you visit other tabs. The encrypted vault relocks after your configurable Windows-lock timeout (10 minutes by default)." Foreground="#B6C8DD" TextWrapping="Wrap" Margin="0,0,0,7"/>
<TextBlock x:Name="PasswordSessionLabel" Text="Locked · unlock to manage saved credentials." Foreground="#7FD9F8" Margin="0,0,0,13" TextWrapping="Wrap"/><TextBlock Text="Currently selected website:" Foreground="#9EB9D6"/><TextBlock x:Name="PasswordSiteName" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,18"/><Border Background="#1B2636" CornerRadius="12" Padding="20" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#2A4155">
              <StackPanel>
                <DockPanel Margin="0,0,0,4">
                  <TextBlock Text="SECURE LOGIN DETAILS" Style="{StaticResource SectionHeader}" DockPanel.Dock="Left"/>
                  <TextBlock x:Name="CredentialStatus" Text="No password saved" Foreground="#6EE7D7" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </DockPanel>
                <TextBlock Text="Saved credentials are encrypted in your local vault. Both fields always stay masked. Leave either field blank to keep its saved value; enter a replacement and click Save credentials to update it." TextWrapping="Wrap" Foreground="#A7B8CB" Margin="0,0,0,11"/>
                <TextBlock Text="How should LaunchFlow sign in?" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                <ComboBox x:Name="LoginModeCombo" SelectedIndex="0" AutomationProperties.Name="Sign-in mode"
                          SelectionChanged="LoginModeCombo_SelectionChanged">
                  <ComboBoxItem Content="Saved password — fill username/password from the vault" Tag="Auto"/>
                  <ComboBoxItem Content="No login required — open page and run configured steps" Tag="None"/>
                  <ComboBoxItem Content="SSO — browser sign-in only (no saved credential fill)" Tag="SSO"/>
                </ComboBox>
                <TextBlock Text="Pick one mode. Saved password uses the fields below (or KeePassXC). No login is for local dashboards. SSO leaves sign-in to your browser and organization." TextWrapping="Wrap" Foreground="#BED2E5" FontSize="12" Margin="0,8,0,0"/>
                <!-- Compatibility: AutoLogin mirrors LoginMode; this control is not a second user decision. -->
                <CheckBox x:Name="AutoLoginCheck" Visibility="Collapsed" Content="Automatically sign in using my saved password"/>
                <TextBlock Text="Use a KeePassXC login (optional)" Style="{StaticResource FieldLabel}" Margin="0,14,0,6"/>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Choose KeePassXC login…" Click="ChooseKeePassEntry_Click"
                          Padding="12,7" Margin="0,0,10,0"/>
                  <TextBlock x:Name="SelectedKeePassEntryLabel" Text="No KeePassXC login selected"
                             Foreground="#A9C4D9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             MaxWidth="310"/>
                </StackPanel>
                <Expander Header="Advanced: edit entry path manually" Foreground="#9FB6CC" Margin="0,8,0,0">
                  <TextBox x:Name="KeepassEntryBox" Margin="0,7,0,4"
                           TextChanged="KeePassEntryTextChanged"
                           ToolTip="Only needed for unusual KeePassXC database layouts"/>
                </Expander>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0"><TextBlock Text="Username or email (hidden)" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="UsernameBox" Background="#0D1522" Foreground="White" BorderBrush="#354358" Padding="9" FontSize="13" Height="35"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="Password (hidden, encrypted when saved)" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="PasswordInput" Background="#0D1522" Foreground="White" BorderBrush="#354358" Padding="9" FontSize="13" Height="35"/></StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,12">
                  <Button Content="Save credentials" Click="SaveCredentials_Click" Background="#55D8C8" Foreground="#061421" FontWeight="SemiBold"/>
                  <Button Content="Remove saved credentials" Click="ClearCredential_Click" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,12">
                  <TextBlock Text="Your username and password are never shown in plain text, including when editing saved credentials." Foreground="#96AFC3" TextWrapping="Wrap"/>
                </StackPanel>
                <!-- Old optional success URL kept invisible for migration and advanced configurations. -->
                <TextBox x:Name="LoginSuccessUrlBox" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Lock encrypted vault" Click="LockPasswords_Click"/><Button Content="Change master password" Click="ChangeMasterPassword_Click"/></StackPanel></StackPanel></ScrollViewer></TabItem>
        <TabItem Header="Startup"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="26" MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="Startup and triggers" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/><Border Background="#141B29" CornerRadius="12" Padding="12" Width="640" Margin="0,0,0,10">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="BACKGROUND &amp; TRIGGERS" FontWeight="SemiBold" Foreground="#A0B4CC" FontSize="11" Margin="0,0,0,7"/>
          <CheckBox x:Name="StartupCheck" Content="Start hidden with Windows (enables Ctrl+M)"/>
          <CheckBox x:Name="UnlockCheck" Content="Run enabled websites after Windows unlock"/>
          <CheckBox x:Name="LaunchCheck" Content="Run enabled websites when LaunchFlow starts"/>
          <CheckBox x:Name="TrayCheck" Content="Allow LaunchFlow to run in the background (system tray)"/>
          <CheckBox x:Name="NotifyCheck" Content="Show a notification when websites finish" IsChecked="True"/>
          <CheckBox x:Name="TaskSchedulerCheck" Content="Use Windows Task Scheduler for Start with Windows (more reliable on some PCs)"/>
          <TextBlock Text="Ctrl+M: run all. Minimize: taskbar. X: choose Exit or Background. Tray menu: Exit." Foreground="#C0D4E5" TextWrapping="Wrap" FontSize="11"/>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Delay after unlock (seconds)" Foreground="#9DAFC5" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBox x:Name="DelayBox" Width="64" Text="5"/>
          </StackPanel>
        </StackPanel></ScrollViewer>
      </Border>
      <TextBlock Text="Some work computers may not support running after unlock." Foreground="#9CAFC8" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></ScrollViewer></TabItem><TabItem Header="Security"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28" MaxWidth="730" HorizontalAlignment="Left"><TextBlock Text="Encrypted vault" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="Your passwords and settings are encrypted. Only you can unlock them." TextWrapping="Wrap" Foreground="#BACCE0" Margin="0,0,0,20"/><TextBlock Text="Lock the vault after Windows stays locked for this many minutes:" TextWrapping="Wrap" Foreground="White" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,10,0,10"><TextBox x:Name="VaultTimeoutBox" Width="72" Text="10" ToolTip="Choose 1 to 120 minutes"/><TextBlock Text="minutes (default 10)" Foreground="#D5E9F3" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock Text="If Windows stays locked longer than this, LaunchFlow will ask for your password again." TextWrapping="Wrap" Foreground="#A2BAD1" Margin="0,6,0,12"/>
                  <TextBlock Text="KeePassXC (optional)" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                  <TextBlock Text="Use your KeePassXC logins without copying passwords into LaunchFlow. Find your password database here, then choose a login in Passwords." TextWrapping="Wrap" Foreground="#BACCE0" Margin="0,0,0,12"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Find my database" Click="FindKeePassDb_Click"
                            Style="{StaticResource PrimaryButton}" Padding="12,7"/>
                    <Button Content="Choose a file…" Click="BrowseKeePassDb_Click" Padding="12,7" Margin="10,0,0,0"/>
                  </StackPanel>
                  <ComboBox x:Name="KeePassDbSuggestions" Visibility="Collapsed" Margin="0,0,0,10"
                            DisplayMemberPath="Display" SelectionChanged="KeePassDbSuggestion_SelectionChanged"
                            ToolTip="Choose your KeePassXC database"/>
                  <TextBlock Text="Selected database" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="KeePassDbBox" IsReadOnly="True" Margin="0,0,0,10"
                           ToolTip="Selected KeePassXC .kdbx file"/>
                  <Expander Header="Advanced: use a key file" Foreground="#A6BCD3" Margin="0,0,0,10">
                    <DockPanel Margin="0,8,0,4">
                      <Button DockPanel.Dock="Right" Content="Choose key file…" Margin="10,0,0,0"
                              Click="BrowseKeePassKey_Click" Padding="12,6"/>
                      <TextBox x:Name="KeePassKeyBox" ToolTip="Only for a KeePassXC database using a separate key file"/>
                    </DockPanel>
                  </Expander>
                  <TextBlock x:Name="KeePassStatusLabel" Text="KeePassXC is not configured"
                             Foreground="#6EE7D7" TextWrapping="Wrap" Margin="0,4,0,0"/>
                  <CheckBox x:Name="SealProfilesCheck" Content="Encrypt browser profiles at rest when the vault locks (recommended)" IsChecked="True" Margin="0,0,0,8"/>
                  <TextBlock Text="Windows Hello" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,8"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="Enable Windows Hello unlock" Click="EnableHello_Click" Padding="14,8" Margin="0,0,10,0"/>
                    <Button Content="Disable Windows Hello" Click="DisableHello_Click" Padding="14,8"/>
                  </StackPanel>

                  
                </StackPanel></ScrollViewer></TabItem><TabItem Header="Updates"><ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Updates &amp; maintenance" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <Border Background="#173440" BorderBrush="#275E64" BorderThickness="1"
                    CornerRadius="11" Padding="14,11" Margin="0,0,0,15" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal">
                <Ellipse Fill="#6EE7D7" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <TextBlock x:Name="CurrentVersionLabel" Text="Installed version" Foreground="#B8EFEB"
                           FontWeight="SemiBold" FontSize="13"/>
              </StackPanel>
            </Border>
            <TextBlock Text="Keep LaunchFlow up to date, verify browser readiness, or create a privacy-safe support report."
                       TextWrapping="Wrap" Foreground="#BACCE0" Margin="0,0,0,16"/>
            <TextBlock Text="New releases" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,9"/>
                  <TextBlock Text="Check whether a new version is available." TextWrapping="Wrap" Foreground="#BACCE0" Margin="0,0,0,8"/>
                  <TextBox x:Name="UpdateFeedBox" Visibility="Collapsed"/>
                  <Button Content="Check for updates" Click="CheckUpdates_Click"
