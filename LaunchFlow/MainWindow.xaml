<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="LaunchFlow.MainWindow" Title="LaunchFlow — Website workspace automation" Width="1140" Height="740" MinWidth="900" MinHeight="510" WindowStyle="SingleBorderWindow" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" WindowStartupLocation="CenterScreen" Background="#0B1220" Foreground="#E9F1FB" FontFamily="Segoe UI" FontSize="13" Closing="OnClosing" Closed="OnClosed" Loaded="OnLoaded" Icon="pack://application:,,,/Assets/LaunchFlow.ico" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Foreground" Value="#A0B4CC"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#9DAFC5"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
    <Style x:Key="TopNavStyle" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#AEBFD2"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,3,0"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="NavFace" Background="{TemplateBinding Background}"
                  BorderBrush="Transparent" BorderThickness="0,0,0,2" CornerRadius="6,6,0,0" Padding="12,10">
            <ContentPresenter ContentSource="Content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="NavFace" Property="Background" Value="#20364C"/>
              <Setter TargetName="NavFace" Property="BorderBrush" Value="#55D8C8"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="NavFace" Property="Background" Value="#2B4057"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <!-- Compact navigation and workflow controls, one real application toolbar. -->
  <Grid Margin="12,8,12,10">
    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#101B2A" BorderBrush="#29394A"
            BorderThickness="1" CornerRadius="8" Padding="11,3">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="LaunchFlow" FontSize="18" FontWeight="Bold"
                   Foreground="#F2F8FE" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <RadioButton x:Name="WorkflowsNav" Content="Workflows" GroupName="TopNavigation"
                       Style="{StaticResource TopNavStyle}" IsChecked="True" Click="TopNavigation_Click"/>
          <RadioButton x:Name="PasswordsNav" Content="Passwords" GroupName="TopNavigation"
                       Style="{StaticResource TopNavStyle}" Click="TopNavigation_Click"/>
          <RadioButton x:Name="SettingsNav" Content="Settings" GroupName="TopNavigation"
                       Style="{StaticResource TopNavStyle}" Click="TopNavigation_Click"/>
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="+ New" Click="AddWorkflow_Click" Style="{StaticResource PrimaryButton}" Padding="9,7"/>
          <Button Content="Save" Click="Save_Click" Padding="9,7"/>
          <Button Content="▶ Run all" Click="Run_Click" Style="{StaticResource PrimaryButton}" Padding="9,7"/>
          <Button x:Name="StopButton" Content="■ Stop" Click="Stop_Click" IsEnabled="False" Padding="9,7"/>
          <Button Content="About" Click="About_Click" Padding="9,7" Margin="0"/>
        </StackPanel>
      </Grid>
    </Border>
<TabControl x:Name="MainTabs" Grid.Row="1" Margin="0,7,0,0" SelectionChanged="MainTabs_SelectionChanged">
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <Border Background="#111A29" BorderBrush="#26364C" BorderThickness="1" CornerRadius="8">
            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
          </Border>
        </ControlTemplate>
      </TabControl.Template><TabItem Header="Workflows"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="245" x:Name="SidebarColumn"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button x:Name="SidebarToggleButton" Grid.Column="1" Content="❮" Click="ToggleSidebar_Click" ToolTip="Show or hide the workflow list" Width="31" Height="42" VerticalAlignment="Top" Margin="0,3,0,0" Padding="2" Background="#26384F"/><Border Grid.Column="0" Background="#141B29" CornerRadius="12" Padding="15" x:Name="SidebarPanel">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,15">
            <TextBlock Text="YOUR WORKFLOWS" FontWeight="SemiBold" FontSize="11" Foreground="#A0B4CC"/>
            <TextBlock Text="Select a site to configure" Foreground="#7D91A8" FontSize="12" Margin="0,7,0,0"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="DuplicateWorkflowButton" Content="Duplicate" Click="DuplicateWorkflow_Click" IsEnabled="False"/>
            <Button x:Name="DeleteWorkflowButton" Content="Delete" Click="DeleteWorkflow_Click" IsEnabled="False" Margin="0"/>
          </StackPanel>
          <ListBox x:Name="WorkflowList" SelectionChanged="WorkflowList_SelectionChanged" DisplayMemberPath="Name" Padding="5" FontSize="14"/>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Background="#141B29" CornerRadius="12" Padding="16">
        <Grid>
        <ScrollViewer x:Name="WorkflowEditorScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel x:Name="EditorPanel">
            <Grid Height="40" Margin="0,0,0,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Workflow editor" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
              <Border Grid.Column="1" Background="#203247" CornerRadius="9" Padding="11,2" VerticalAlignment="Center">
                <CheckBox x:Name="EnabledCheck" Content="Enabled" VerticalAlignment="Center"
                          VerticalContentAlignment="Center" HorizontalAlignment="Center" Margin="0"/>
              </Border>
            </Grid>
            <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NameBox" Margin="0,0,0,10"/>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0"><TextBlock Text="Login / start URL" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="StartUrlBox" ToolTip="Full URL, including https://"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Browser" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="BrowserCombo" SelectedIndex="0">
                  <ComboBoxItem Content="Edge"/><ComboBoxItem Content="Chrome"/>
                  <ComboBoxItem Content="Firefox"/>
                  <ComboBoxItem Content="Default browser (open only)"/>
                </ComboBox></StackPanel>
            </Grid>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Screen" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="MonitorCombo"/>
              </StackPanel>
              <Button Grid.Column="2" Content="▶ Test this site" Click="RunSelected_Click" VerticalAlignment="Bottom" Margin="0"/>
            </Grid>
            <!-- Legacy control retained for settings compatibility. Old destinations migrate to steps. -->
            <TextBox x:Name="DestinationUrlBox" Visibility="Collapsed"/>
            <TextBlock Text="Save a login, then Run. Use Add page for another URL after sign-in." TextWrapping="Wrap" Foreground="#BED2E5" Margin="0,0,0,10" FontSize="12"/>
            <DockPanel Margin="0,0,0,8">
              <TextBlock Text="ACTIONS AFTER SIGN-IN" Style="{StaticResource SectionHeader}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
              <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="● Teach" Click="RecordSteps_Click" Style="{StaticResource PrimaryButton}"
                        AutomationProperties.Name="Teach by clicking" ToolTip="Record clicks from the live site" Margin="0,0,6,6"/>
                <Button Content="Repair login" Click="RepairLogin_Click" Margin="0,0,6,6"
                        ToolTip="Open the site and teach steps when auto-login or MFA breaks"/>
                <Button Content="+ Page" Click="AddPage_Click" ToolTip="Open another website/page after sign-in" Margin="0,0,6,6"/>
                <Button Content="+ Action" Click="AddStep_Click" Margin="0,0,6,6"/>
                <Button Content="Edit" Click="EditStep_Click" Margin="0,0,6,6"/>
                <Button Content="Remove" Click="RemoveStep_Click" Margin="0,0,0,6"/>
              </WrapPanel>
            </DockPanel>
            <ListBox x:Name="StepList" Height="120" FontSize="13" MouseDoubleClick="EditStep_Click"
                     AutomationProperties.Name="Workflow steps after sign-in"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
              <Button Content="↑ Up" Click="MoveStepUp_Click"/>
              <Button Content="↓ Down" Click="MoveStepDown_Click" Margin="0"/>
            </StackPanel>
            <TextBlock Text="Teach records clicks (skips passwords). Repair login helps when SSO/MFA breaks. Never put passwords in steps." TextWrapping="Wrap" Foreground="#91A1B7" FontSize="11" Margin="0,8,0,0"/>
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="WorkflowEmptyState" Visibility="Visible" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Margin="16">
          <StackPanel HorizontalAlignment="Center">
            <Border Width="76" Height="76" Background="#203854" CornerRadius="18" HorizontalAlignment="Center" Margin="0,0,0,18">
              <TextBlock Text="+" FontSize="48" FontWeight="Light" Foreground="#6EE7D7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="EmptyStateHeading" Text="No workflows yet" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock x:Name="EmptyStateDescription" Text="Create your first workflow to choose a website, add your login, and pick a monitor. The editor will appear after you create it." Foreground="#A9BDD4" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" Margin="0,0,0,22"/>
            <Button x:Name="CreateFirstWorkflowButton" Content="+ Create your first workflow" Click="AddWorkflow_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" MinWidth="230" Padding="20,12"/>
          </StackPanel>
        </Grid>
        </Grid>
      </Border>
    </Grid>
    </TabItem><TabItem Header="Passwords"><ScrollViewer VerticalScrollBarVisibility="Auto" Background="#111A2A"><StackPanel Margin="28" MaxWidth="840" HorizontalAlignment="Left"><TextBlock Text="Password manager" FontSize="23" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock Text="One master-password unlock lasts one hour, even if you visit other tabs. The encrypted vault relocks after your configurable Windows-lock timeout (10 minutes by default)." Foreground="#B6C8DD" TextWrapping="Wrap" Margin="0,0,0,7"/>
<TextBlock x:Name="PasswordSessionLabel" Text="Locked · unlock to manage saved credentials." Foreground="#7FD9F8" Margin="0,0,0,13" TextWrapping="Wrap"/><TextBlock Text="Currently selected workflow:" Foreground="#9EB9D6"/><TextBlock x:Name="PasswordSiteName" FontSize="17" FontWeight="SemiBold" Margin="0,5,0,18"/><Border Background="#1B2636" CornerRadius="10" Padding="17" Margin="0,0,0,10">
              <StackPanel>
                <DockPanel Margin="0,0,0,4">
                  <TextBlock Text="Encrypted sign-in vault" Style="{StaticResource SectionHeader}" DockPanel.Dock="Left"/>
                  <TextBlock x:Name="CredentialStatus" Text="No password saved" Foreground="#6EE7D7" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </DockPanel>
                <TextBlock Text="Saved credentials are encrypted in your local vault. Both fields always stay masked. Leave either field blank to keep its saved value; enter a replacement and click Save credentials to update it." TextWrapping="Wrap" Foreground="#A7B8CB" Margin="0,0,0,11"/>
                <CheckBox x:Name="AutoLoginCheck" Content="Automatically sign in using my saved password"/>
                <TextBlock Text="Optional KeePassXC entry path (group/title)" Style="{StaticResource FieldLabel}" Margin="0,12,0,6"/>
                <TextBox x:Name="KeepassEntryBox" ToolTip="Example: Internet/Work Portal — uses Settings → Security KeePass database when local vault has no password for this workflow"/>
                <TextBlock Text="Login type is detected automatically (email first, Next, password, SSO or MFA)." Style="{StaticResource FieldLabel}" Margin="0,9,0,6" TextWrapping="Wrap" Visibility="Collapsed"/>
                <ComboBox x:Name="LoginModeCombo" SelectedIndex="0" Visibility="Collapsed">
                  <ComboBoxItem Content="Automatic"/>
                  <ComboBoxItem Content="None"/>
                </ComboBox>
                <TextBlock Text="LaunchFlow detects username/Next/password steps. If your company uses SSO, you may need to approve its login address once and complete MFA yourself." TextWrapping="Wrap" Foreground="#BED2E5" FontSize="12" Margin="0,8,0,0"/>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0"><TextBlock Text="Username or email (hidden)" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="UsernameBox" Background="#0D1522" Foreground="White" BorderBrush="#354358" Padding="9" FontSize="13" Height="35"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Text="Password (hidden, encrypted when saved)" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="PasswordInput" Background="#0D1522" Foreground="White" BorderBrush="#354358" Padding="9" FontSize="13" Height="35"/></StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,12">
                  <Button Content="Save credentials" Click="SaveCredentials_Click" Background="#36CBBB" Foreground="#061421" FontWeight="SemiBold"/>
                  <Button Content="Remove saved credentials" Click="ClearCredential_Click" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,12">
                  <TextBlock Text="Your username and password are never shown in plain text, including when editing saved credentials." Foreground="#91A1B7" TextWrapping="Wrap"/>
                </StackPanel>
                <!-- Old optional success URL kept invisible for migration and advanced configurations. -->
                <TextBox x:Name="LoginSuccessUrlBox" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Button Content="Lock encrypted vault" Click="LockPasswords_Click"/><Button Content="Change master password" Click="ChangeMasterPassword_Click"/></StackPanel></StackPanel></ScrollViewer></TabItem><TabItem Header="Settings">
      <TabControl x:Name="SettingsTabs" Margin="0" Background="#111A2A" TabStripPlacement="Left" BorderThickness="0" Padding="8">
        <TabControl.Resources>
          <Style TargetType="TabItem">
            <Setter Property="MinWidth" Value="175"/>
            <Setter Property="Foreground" Value="#AFC3D8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
            <Setter Property="Template"><Setter.Value>
              <ControlTemplate TargetType="TabItem">
                <Border x:Name="NavItem" Background="{TemplateBinding Background}"
                        BorderBrush="Transparent" BorderThickness="3,0,0,0"
                        CornerRadius="5" Padding="{TemplateBinding Padding}">
                  <ContentPresenter ContentSource="Header" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="NavItem" Property="Background" Value="#223950"/>
                    <Setter TargetName="NavItem" Property="BorderBrush" Value="#55D8C8"/>
                    <Setter Property="Foreground" Value="White"/>
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="NavItem" Property="Background" Value="#29425D"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value></Setter>
          </Style>
        </TabControl.Resources>
        <TabItem Header="General"><ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock Text="Configure LaunchFlow using the categories on the left." Foreground="#AEC5DD"
                       FontSize="14" TextWrapping="Wrap" Margin="0,0,0,25"/>
            <TextBlock Text="Startup and background" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,7"/>
            <TextBlock Text="Windows startup, unlock triggers and system tray behavior." Foreground="#A1BCD2" Margin="0,0,0,22"/>
            <TextBlock Text="Security and passwords" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,7"/>
            <TextBlock Text="Encryption, vault access and local backups." Foreground="#A1BCD2" Margin="0,0,0,22"/>
            <TextBlock Text="Shortcuts, updates and advanced" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,7"/>
            <TextBlock Text="Customize your shortcut, check for new releases and adjust advanced sign-in."
                       Foreground="#A1BCD2" TextWrapping="Wrap" Margin="0,0,0,25"/>
            <TextBlock Text="Remember to use Save in the top toolbar after changing settings." Foreground="#6EE7D7"/>
          </StackPanel>
        </ScrollViewer></TabItem>
        <TabItem Header="Startup"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="26" MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="Startup and triggers" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/><Border Background="#141B29" CornerRadius="12" Padding="12" Width="640" Margin="0,0,0,10">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="BACKGROUND &amp; TRIGGERS" FontWeight="SemiBold" Foreground="#A0B4CC" FontSize="11" Margin="0,0,0,7"/>
          <CheckBox x:Name="StartupCheck" Content="Start hidden with Windows (enables Ctrl+M)"/>
          <CheckBox x:Name="UnlockCheck" Content="Run enabled workflows after Windows unlock"/>
          <CheckBox x:Name="LaunchCheck" Content="Run enabled workflows when LaunchFlow starts"/>
          <CheckBox x:Name="TrayCheck" Content="Allow LaunchFlow to run in the background (system tray)"/>
          <CheckBox x:Name="NotifyCheck" Content="Show a notification when workflows finish" IsChecked="True"/>
          <CheckBox x:Name="TaskSchedulerCheck" Content="Use Windows Task Scheduler for Start with Windows (more reliable on some PCs)"/>
          <TextBlock Text="Ctrl+M: run all. Minimize: taskbar. X: choose Exit or Background. Tray menu: Exit." Foreground="#C0D4E5" TextWrapping="Wrap" FontSize="11"/>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Delay after unlock (seconds)" Foreground="#9DAFC5" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBox x:Name="DelayBox" Width="64" Text="5"/>
          </StackPanel>
        </StackPanel></ScrollViewer>
      </Border>
      <TextBlock Text="Windows session unlock triggers work when Windows reports a real unlock. An organization-specific transparent overlay may not send this event; LaunchFlow does not bypass it." Foreground="#9CAFC8" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></ScrollViewer></TabItem><TabItem Header="Security"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28" MaxWidth="730" HorizontalAlignment="Left"><TextBlock Text="Encrypted vault" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="Workflows and credentials are stored as AES-256-GCM encrypted records inside the local SQLite database. Your master password is required at each application start. It is not stored by Windows DPAPI." TextWrapping="Wrap" Foreground="#BACCE0" Margin="0,0,0,20"/><TextBlock Text="Lock the vault after Windows stays locked for this many minutes:" TextWrapping="Wrap" Foreground="White" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,10,0,10"><TextBox x:Name="VaultTimeoutBox" Width="72" Text="10" ToolTip="Choose 1 to 120 minutes"/><TextBlock Text="minutes (default 10)" Foreground="#D5E9F3" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock Text="For a shorter Windows lock: keep the vault unlocked. At or beyond the threshold: discard the encryption key and ask for the master password after Windows unlocks. While Windows is locked, automation is paused. This does not log out already-open browser sessions." TextWrapping="Wrap" Foreground="#A2BAD1" Margin="0,6,0,12"/><TextBlock Text="New database: %LOCALAPPDATA%\LaunchFlow\launchflow.db. Previous settings.json/vault.json/security.json files are retained as migration backups. Use Import / Export to move encrypted configuration to another PC." TextWrapping="Wrap" Foreground="#A2BAD1" Margin="0,0,0,22"/>
                  <TextBlock Text="KeePassXC (optional)" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                  <TextBlock Text="Point LaunchFlow at your .kdbx file. Workflows can use an entry path instead of (or as fallback for) the local vault. Requires KeePassXC installed so keepassxc-cli is available. The KeePass master password is prompted when a run needs it and is not stored." TextWrapping="Wrap" Foreground="#BACCE0" Margin="0,0,0,12"/>
                  <TextBlock Text="Database path (.kdbx)" Style="{StaticResource FieldLabel}"/>
                  <DockPanel Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Content="Browse…" Margin="10,0,0,0" Click="BrowseKeePassDb_Click" Padding="12,6"/>
                    <TextBox x:Name="KeePassDbBox"/>
                  </DockPanel>
                  <TextBlock Text="Key file (optional)" Style="{StaticResource FieldLabel}"/>
                  <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Browse…" Margin="10,0,0,0" Click="BrowseKeePassKey_Click" Padding="12,6"/>
                    <TextBox x:Name="KeePassKeyBox"/>
                  </DockPanel>
                  <TextBlock x:Name="KeePassStatusLabel" Text="KeePassXC: not configured" Foreground="#6EE7D7" Margin="0,4,0,0"/>
                  <TextBlock Text="What is protected" FontSize="20" FontWeight="SemiBold" Margin="0,28,0,8"/>
                  <TextBlock x:Name="SecurityClarityText" TextWrapping="Wrap" Foreground="#BACCE0" Margin="0,0,0,12"/>
                  <CheckBox x:Name="SealProfilesCheck" Content="Encrypt browser profiles at rest when the vault locks (recommended)" IsChecked="True" Margin="0,0,0,8"/>
                  <CheckBox x:Name="DiagnosticsCheck" Content="Write a local diagnostics.log (never uploaded)" Margin="0,0,0,12"/>
                  <TextBlock Text="Windows Hello" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,8"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="Enable Windows Hello unlock" Click="EnableHello_Click" Padding="14,8" Margin="0,0,10,0"/>
                    <Button Content="Disable Windows Hello" Click="DisableHello_Click" Padding="14,8"/>
                  </StackPanel>
                  <TextBlock Text="Local backups" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,8"/>
                  <TextBlock Text="LaunchFlow can copy your already-encrypted database into a backups folder. These copies still need your master password. Use Restore to put a backup back, or double-click a portable .launchflow export to import it. Keep an export somewhere safe as well." TextWrapping="Wrap" Foreground="#BACCE0" Margin="0,0,0,12"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Remind me every" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="BackupReminderBox" Width="48" Text="14"/>
                    <TextBlock Text="days (0 = off)" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Backup encrypted database now" Click="BackupVault_Click" Padding="14,8" Margin="0,0,10,0"/>
                    <Button Content="Restore from backup…" Click="RestoreVault_Click" Padding="14,8" Margin="0,0,10,0"
                            ToolTip="Replace the live vault with an encrypted launchflow-*.db copy from the backups folder"/>
                    <Button Content="Open data folder" Click="OpenDataFolder_Click" Padding="14,8"/>
                  </StackPanel>
                  <TextBlock x:Name="VaultBackupStatus" Text="" Foreground="#6EE7D7" TextWrapping="Wrap"/>
                  <TextBlock x:Name="BrowserReadyLabel" Text="" Foreground="#A2BAD1" TextWrapping="Wrap" Margin="0,16,0,0"/>
                  
                </StackPanel></ScrollViewer></TabItem><TabItem Header="Updates"><ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="28" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Application updates" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,12"/>
            <TextBlock Text="Find the latest stable LaunchFlow release. Use the Universal Installer to install updates."
                       TextWrapping="Wrap" Foreground="#BACCE0" Margin="0,0,0,16"/>
            <TextBlock Text="Updates" FontSize="20" FontWeight="SemiBold" Margin="0,24,0,8"/>
                  <TextBlock Text="Enter an optional custom release feed, or leave blank to use the official LaunchFlow GitHub Releases feed." TextWrapping="Wrap" Foreground="#BACCE0" Margin="0,0,0,8"/>
                  <TextBox x:Name="UpdateFeedBox" Margin="0,0,0,8"/>
                  <Button Content="Check for updates" Click="CheckUpdates_Click" Padding="14,8" HorizontalAlignment="Left"/>
                  <TextBlock x:Name="UpdateStatusLabel" Foreground="#6EE7D7" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
        </ScrollViewer></TabItem><TabItem Header="Shortcuts"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28" MaxWidth="750" HorizontalAlignment="Left"><TextBlock Text="Keyboard shortcut" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBlock Text="LaunchFlow always listens for this shortcut while running, including when hidden in the system tray. Press a combination containing Ctrl, Alt or Shift." TextWrapping="Wrap" Foreground="#A9BBD3" Margin="0,0,0,20"/><StackPanel Orientation="Horizontal"><TextBox x:Name="ShortcutBox" IsReadOnly="True" Width="210" Text="Ctrl+M" Margin="0,0,14,0"/><Button x:Name="CaptureButton" Content="Change shortcut" Click="CaptureShortcut_Click"/></StackPanel><TextBlock x:Name="ShortcutHelpLabel" Text="Default: Ctrl+M" Margin="0,11,0,0" Foreground="#86DBF3" TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem><TabItem Header="Advanced"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28" MaxWidth="790" HorizontalAlignment="Left"><TextBlock Text="Advanced sign-in options" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBlock Text="These optional fields apply to the currently selected workflow. Most websites do not require changing them." Foreground="#ABBDD3" TextWrapping="Wrap" Margin="0,0,0,14"/><Expander Header="Advanced settings (only if the website needs them)" Foreground="#D9F1FC" Background="#18283C" Padding="10" Margin="0,0,0,12" IsExpanded="True">
                  <StackPanel Margin="4,10,4,4">
                    <TextBlock Text="Trusted username page address (HTTPS; blank = start URL)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="CredentialOriginBox" Margin="0,0,0,11" ToolTip="Example: https://login.example.com"/>
                    <TextBlock Text="Trusted password page address (HTTPS; only if different)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="PasswordOriginBox" Margin="0,0,0,11" ToolTip="If your employer redirects to a different SSO domain, set its exact HTTPS origin here."/>
                    <Grid Margin="0,0,0,11">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0"><TextBlock Text="Username field (CSS)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="UsernameSelectorBox"/></StackPanel>
                      <StackPanel Grid.Column="2"><TextBlock Text="Password field (CSS)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PasswordSelectorBox"/></StackPanel>
                    </Grid>
                    <TextBlock Text="Next button after username (for two-page logins)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="UsernameContinueBox" Margin="0,0,0,11"/>
                    <TextBlock Text="Final sign-in button (CSS; blank means click manually)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="SubmitSelectorBox" Margin="0,0,0,11"/>
                    <TextBlock Text="Visible element after successful login (CSS, optional)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="LoginSuccessSelectorBox" Margin="0,0,0,11"/>
                  </StackPanel>
                </Expander>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="Sign-in timeout (seconds)" Foreground="#9DAFC5" VerticalAlignment="Center" Margin="0,0,15,0"/>
                  <TextBox x:Name="LoginWaitBox" Width="75" Text="60"/>
                  <TextBlock Text="MFA always stays under your control." Foreground="#91A1B7" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
              </StackPanel></ScrollViewer></TabItem><TabItem Header="Import / Export"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28" MaxWidth="790" HorizontalAlignment="Left"><TextBlock Text="Move to another PC" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBlock Text="Export a portable password-encrypted .launchflow file. Saved website credentials can be included and will be encrypted with your new vault master key when imported. Browser sessions and cookies are not transferred." Foreground="#B3C6DD" TextWrapping="Wrap" Margin="0,0,0,16"/><CheckBox x:Name="IncludePasswordsCheck" Content="Include saved login passwords in encrypted export" IsChecked="True"/><Button Content="Export encrypted configuration…" Click="Export_Click" Width="275" HorizontalAlignment="Left" Margin="0,12,0,15"/><Button Content="Import configuration…" Click="Import_Click" Width="275" HorizontalAlignment="Left"/><TextBlock Text="Import replaces existing workflows and saved login credentials after confirmation. Always keep the export password safe; it cannot be recovered." Foreground="#E6B6A0" TextWrapping="Wrap" Margin="0,15,0,0"/></StackPanel></ScrollViewer></TabItem><TabItem Header="Activity"><Grid Margin="18"><Border Background="#141B29" CornerRadius="12" Padding="16">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,9">
            <TextBlock Text="ACTIVITY LOG" Foreground="#A0B4CC" FontWeight="SemiBold" FontSize="11" DockPanel.Dock="Left"/>
            <TextBlock x:Name="StatusLabel" Text="Ready" Foreground="#6EE7D7" HorizontalAlignment="Right"/>
          </DockPanel>
          <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Background="#0D1522" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </DockPanel>
      </Border>
    </Grid></TabItem></TabControl></TabItem></TabControl></Grid></Window>
