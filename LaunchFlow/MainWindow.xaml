                  <Expander Header="Advanced: use a key file" Foreground="#A6BCD3" Margin="0,0,0,10">
                    <DockPanel Margin="0,8,0,4">
                      <Button DockPanel.Dock="Right" Content="Choose key file…" Margin="10,0,0,0"
