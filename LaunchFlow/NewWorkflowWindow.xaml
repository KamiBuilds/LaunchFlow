<Window x:Class="LaunchFlow.NewWorkflowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a website - LaunchFlow" Width="580" Height="620" MinWidth="480" MinHeight="480"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="#111A2A" Foreground="#EEF6FA" FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Assets/LaunchFlow.ico">
  <Grid Margin="24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Add your website" FontSize="23" FontWeight="SemiBold"/>
      <TextBlock Text="Start with a name and website address. You can adjust everything later."
                 Margin="0,8,0,0" Foreground="#B4CCDB" TextWrapping="Wrap"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" Margin="0,16,0,12" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="1. Which website?" Foreground="#6EE7D7" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBlock Text="Website name" FontWeight="SemiBold"/>
        <TextBox x:Name="NameBox" Margin="0,6,0,12" Text="My website"/>
        <TextBlock Text="Website address (URL)" FontWeight="SemiBold"/>
        <DockPanel Margin="0,6,0,6">
          <Button DockPanel.Dock="Right" Content="Paste URL" Click="PasteUrl_Click"
                  Margin="8,0,0,0" ToolTip="Paste a copied website address or local IP"/>
          <TextBox x:Name="UrlBox" Text="" VerticalContentAlignment="Center"
                   ToolTip="Examples: example.com, 192.168.1.50, localhost:3000, http://192.168.1.50:8080"/>
        </DockPanel>
        <Expander Header="Advanced: connection type and port (optional)"
                  Foreground="#C0D6E5" Background="#17283A" Padding="10" Margin="0,0,0,16">
          <StackPanel Margin="3,8,3,4">
            <TextBlock Text="Usually you can leave these settings unchanged."
                       Foreground="#B4CCDB" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <Grid Margin="0,4,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Connection" FontWeight="SemiBold"/>
                <ComboBox x:Name="ProtocolCombo" Margin="0,6,0,0" SelectedIndex="0">
                  <ComboBoxItem Content="Auto (recommended)"/>
                  <ComboBoxItem Content="HTTPS"/>
                  <ComboBoxItem Content="HTTP"/>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Port (optional)" FontWeight="SemiBold"/>
                <TextBox x:Name="PortBox" Margin="0,6,0,0" MaxLength="5"
                         ToolTip="For example, 8080 or 3000 (range 1–65535). Overrides a port in the address."/>
              </StackPanel>
            </Grid>
            <TextBlock Text="Examples: example.com, 192.168.1.50:8080 or localhost:3000. Auto uses HTTP for local addresses and HTTPS for websites. Pasted full URLs keep their protocol."
                       FontSize="11" Foreground="#B4CCDB" TextWrapping="Wrap" Margin="0,0,0,6"/>
            <TextBlock Text="HTTP isn't encrypted. Use HTTPS for sensitive logins whenever possible."
                       FontSize="11" Foreground="#E6B96F" TextWrapping="Wrap" Margin="0,0,0,12"/>
    
          </StackPanel>
        </Expander>
        <TextBlock Text="2. Where should it open?" Foreground="#6EE7D7" FontSize="16"
                   FontWeight="SemiBold" Margin="0,0,0,10"/>
        <TextBlock Text="Browser" FontWeight="SemiBold"/>
        <ComboBox x:Name="BrowserCombo" Margin="0,6,0,12"
                  DropDownOpened="BrowserCombo_DropDownOpened"
                  ToolTip="Shows installed browsers. The default browser opens without automatic login."/>
        <TextBlock Text="Screen (monitor)" FontWeight="SemiBold"/>
        <ComboBox x:Name="MonitorCombo" Margin="0,6,0,12"/>
        <TextBlock Text="3. Automatic login (optional)" Foreground="#6EE7D7" FontSize="16"
                   FontWeight="SemiBold" Margin="0,0,0,9"/>
        <CheckBox x:Name="AutoLoginCheck" Content="Yes, automatically sign in to this website" IsChecked="False"/>
        <TextBlock Text="Leave this unchecked if the site doesn't need a password. You can add or change login details later in Passwords."
                   TextWrapping="Wrap" Foreground="#B4CCDB" FontSize="11" Margin="0,5,0,9"/>
        <StackPanel>
          <StackPanel.Style>
            <Style TargetType="StackPanel">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=AutoLoginCheck}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </StackPanel.Style>
          <Border Background="#17283A" CornerRadius="9" Padding="12" Margin="0,3,0,5">
            <StackPanel>
              <TextBlock Text="These login details are encrypted locally, not included in recorded actions."
                         Foreground="#B9DDDA" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,7"/>
        <TextBlock Text="Username / email (hidden)" FontWeight="SemiBold" Margin="0,10,0,0"/>
              <PasswordBox x:Name="UsernameBox" IsEnabled="{Binding IsChecked, ElementName=AutoLoginCheck}" Margin="0,6,0,12" Height="36" Background="#0D1522" Foreground="White" BorderBrush="#354358" Padding="10,8"/>
              <TextBlock Text="Password" FontWeight="SemiBold"/>
              <PasswordBox x:Name="PasswordBox" IsEnabled="{Binding IsChecked, ElementName=AutoLoginCheck}" Margin="0,6,0,0" Height="36" Background="#0D1522"
                           Foreground="White" BorderBrush="#354358" Padding="10,8"/>
              <TextBlock Text="Using KeePassXC? After creating this website, open Passwords and choose your KeePassXC login. No paths to type."
                         Foreground="#B4CCDB" Margin="0,12,0,0" TextWrapping="Wrap"/>
      
            </StackPanel>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                ToolTip="Next: select this website in Websites and click Test this site">
      <Button Content="Cancel" Width="100" Height="38" Margin="0,0,10,0" Click="Cancel_Click"/>
      <Button Content="Create website" Width="145" Height="38" Style="{StaticResource PrimaryButton}"
              IsDefault="True" Click="Create_Click"/>
    </StackPanel>
  </Grid>
</Window>
