<Window x:Class="LaunchFlow.NewWorkflowWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New workflow" Width="520" Height="520" MinWidth="480" MinHeight="480"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="#111A2A" Foreground="#E9F1FB" FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Assets/LaunchFlow.ico">
  <Grid Margin="24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Create a workflow" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="Add a website, choose where it opens, and optionally save a login."
                 Margin="0,8,0,0" Foreground="#A8BED6" TextWrapping="Wrap"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" Margin="0,16,0,12" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="Name" FontWeight="SemiBold"/>
        <TextBox x:Name="NameBox" Margin="0,6,0,12" Text="My website"/>
        <TextBlock Text="Website address or IP" FontWeight="SemiBold"/>
        <DockPanel Margin="0,6,0,6">
          <Button DockPanel.Dock="Right" Content="Paste URL" Click="PasteUrl_Click"
                  Margin="8,0,0,0" ToolTip="Paste a copied website address or local IP"/>
          <TextBox x:Name="UrlBox" Text="" VerticalContentAlignment="Center"
                   ToolTip="Examples: example.com, 192.168.1.50, localhost:3000, http://192.168.1.50:8080"/>
        </DockPanel>
        <Grid Margin="0,4,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Connection" FontWeight="SemiBold"/>
            <ComboBox x:Name="ProtocolCombo" Margin="0,6,0,0" SelectedIndex="0">
              <ComboBoxItem Content="Auto"/>
              <ComboBoxItem Content="HTTPS"/>
              <ComboBoxItem Content="HTTP"/>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="Port (optional)" FontWeight="SemiBold"/>
            <TextBox x:Name="PortBox" Margin="0,6,0,0" MaxLength="5"
                     ToolTip="For example, 8080 or 3000 (range 1–65535). Overrides a port in the address."/>
          </StackPanel>
        </Grid>
        <TextBlock Text="Examples: example.com, 192.168.1.50:8080 or localhost:3000. Auto uses HTTP for local addresses and HTTPS for websites. Pasted full URLs keep their protocol."
                   FontSize="11" Foreground="#A8BED6" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <TextBlock Text="HTTP isn't encrypted. Use HTTPS for sensitive logins whenever possible."
                   FontSize="11" Foreground="#E6B96F" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock Text="Browser" FontWeight="SemiBold"/>
        <ComboBox x:Name="BrowserCombo" Margin="0,6,0,12" SelectedIndex="0">
          <ComboBoxItem Content="Edge"/>
          <ComboBoxItem Content="Chrome"/>
          <ComboBoxItem Content="Firefox"/>
          <ComboBoxItem Content="Default browser (open only)"/>
        </ComboBox>
        <TextBlock Text="Screen to open on" FontWeight="SemiBold"/>
        <ComboBox x:Name="MonitorCombo" Margin="0,6,0,12"/>
        <CheckBox x:Name="AutoLoginCheck" Content="Sign in using my saved details" IsChecked="True"/>
        <TextBlock Text="Username / email (hidden)" FontWeight="SemiBold" Margin="0,10,0,0"/>
        <PasswordBox x:Name="UsernameBox" Margin="0,6,0,12" Height="36" Background="#0D1522" Foreground="White" BorderBrush="#354358" Padding="10,8"/>
        <TextBlock Text="Password" FontWeight="SemiBold"/>
        <PasswordBox x:Name="PasswordBox" Margin="0,6,0,0" Height="36" Background="#0D1522"
                     Foreground="White" BorderBrush="#354358" Padding="10,8"/>
        <TextBlock Text="Advanced: KeePassXC entry (optional)"
                   FontWeight="SemiBold" Margin="0,12,0,0" Foreground="#A8BED6"/>
        <TextBox x:Name="KeepassPathBox" Margin="0,6,0,0"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" Width="100" Height="38" Margin="0,0,10,0" Click="Cancel_Click"/>
      <Button Content="Create" Width="110" Height="38" Style="{StaticResource PrimaryButton}"
              IsDefault="True" Click="Create_Click"/>
    </StackPanel>
  </Grid>
</Window>
