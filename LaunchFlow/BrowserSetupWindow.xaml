<Window x:Class="LaunchFlow.BrowserSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Browser readiness" Width="530" Height="330"
        MinWidth="500" MinHeight="300" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#101A2A"
        Foreground="#E9F1FB" FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Assets/LaunchFlow.ico">
  <StackPanel Margin="26">
    <TextBlock Text="Browser readiness" FontSize="23" FontWeight="SemiBold"/>
    <TextBlock x:Name="ReadinessText" TextWrapping="Wrap" Margin="0,12,0,16"
               AutomationProperties.Name="Detected supported browsers"/>
    <TextBlock Text="LaunchFlow uses installed Microsoft Edge or Google Chrome for browser automation."
               TextWrapping="Wrap" Foreground="#AEC4DB" Margin="0,0,0,14"/>
    <TextBlock Text="Downloading a browser is optional. Follow your organization's software policies."
               TextWrapping="Wrap" Foreground="#AEC4DB" Margin="0,0,0,16"/>
    <WrapPanel>
      <Button Content="Microsoft Edge website" Click="Edge_Click" Padding="12,9" Margin="0,0,9,0"
              AutomationProperties.Name="Open official Microsoft Edge download site"/>
      <Button Content="Google Chrome website" Click="Chrome_Click" Padding="12,9" Margin="0,0,9,0"
              AutomationProperties.Name="Open official Google Chrome download site"/>
      <Button Content="Check again" Click="Refresh_Click" Padding="12,9"
              AutomationProperties.Name="Check installed browsers again"/>
    </WrapPanel>
    <TextBlock Text="Firefox requires a compatible Playwright browser runtime and is not configured by this dialog."
               Margin="0,16,0,0" Foreground="#819AB4" TextWrapping="Wrap"/>
  </StackPanel>
</Window>
