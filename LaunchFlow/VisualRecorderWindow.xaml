<Window x:Class="LaunchFlow.VisualRecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Record actions - LaunchFlow" Width="720" Height="590" MinWidth="560" MinHeight="455"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="True"
        Background="#0D1725" Foreground="#EEF6FA" FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Assets/LaunchFlow.ico" Closed="Window_Closed">
  <Grid Margin="22,19">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="Record actions" FontSize="24" FontWeight="SemiBold" Foreground="#F4FAFF"/>
      <TextBlock Text="Use the website opened by LaunchFlow. Click buttons or press navigation keys, then save your actions."
                 Foreground="#AEC5D9" TextWrapping="Wrap" Margin="0,5,0,0"/>
    </StackPanel>

    <Border Grid.Row="1" Background="#16283A" BorderBrush="#2C5061" BorderThickness="1"
            CornerRadius="12" Padding="15,13" Margin="0,0,0,14">
      <StackPanel>
        <DockPanel LastChildFill="True" Margin="0,0,0,5">
          <Ellipse Width="9" Height="9" Fill="#62E1CA" Margin="0,0,9,0"
                   DockPanel.Dock="Left" VerticalAlignment="Center"/>
          <TextBlock x:Name="CaptureStatus" Text="Connecting to browser…" FontSize="14"
                     FontWeight="SemiBold" Foreground="#8EEDDE" TextWrapping="Wrap"/>
        </DockPanel>
        <TextBlock x:Name="TargetStatus" Text="Checking which browser tab is being recorded…"
                   Foreground="#B3C9DA" FontSize="12" TextWrapping="Wrap" Margin="18,0,0,12"/>
        <WrapPanel>
          <Button x:Name="CaptureToggle" Content="Pause recording" Style="{StaticResource PrimaryButton}"
                  Click="ToggleCapture_Click" Margin="0,0,10,5" Padding="15,9"
                  ToolTip="Recording starts automatically"/>
          <Button Content="Add current page" Click="CaptureUrl_Click" Margin="0,0,8,5" Padding="14,9"
                  ToolTip="Add a navigation step for the active browser page"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Background="#111D2E" BorderBrush="#293D53" BorderThickness="1"
            CornerRadius="12" Padding="15" Margin="0,0,0,14">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
          <TextBlock Text="Recorded actions" FontSize="16" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
          <Border DockPanel.Dock="Right" Background="#214256" CornerRadius="14"
                  Padding="11,4" HorizontalAlignment="Right">
            <TextBlock x:Name="RecordedCountLabel" Text="0 actions" Foreground="#A0EBDE"
                       FontWeight="SemiBold" FontSize="12"/>
          </Border>
        </DockPanel>
        <Grid Grid.Row="1" MinHeight="105">
          <ListBox x:Name="StepList" DisplayMemberPath="Description" SelectionMode="Extended"
                   MouseDoubleClick="EditSelected_Click" Padding="8" Background="#0D1725"
                   BorderBrush="#2B4056" BorderThickness="1"
                   AutomationProperties.Name="Recorded website clicks"/>
          <TextBlock x:Name="EmptyStepsHint"
                     Text="No actions yet. Click a safe button in the browser LaunchFlow opened."
                     Foreground="#93ABBF" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                     IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center"
                     MaxWidth="380" Margin="15"/>
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
          <Expander Header="More options (optional)" Foreground="#D8E9F7"
                    Background="#1B2B40" Margin="0,0,0,8" Padding="7">
            <WrapPanel Margin="5,8,5,2">
              <Button Content="Add a page" Click="AddNavigate_Click" Margin="0,0,7,7"/>
              <Button Content="Add a click" Click="AddClick_Click" Margin="0,0,7,7"/>
              <Button Content="Add a wait" Click="AddWait_Click" Margin="0,0,7,7"/>
              <Button Content="Wait +1s" Click="QuickWait_Click" Margin="0,0,7,7"/>
              <Button Content="Edit selected" Click="EditSelected_Click" Margin="0,0,7,7"/>
              <Button Content="Select all" Click="SelectAll_Click" Margin="0,0,7,7"/>
              <Button Content="Delete selected" Click="Remove_Click" Margin="0,0,7,7"/>
              <Button Content="Clear all" Click="Clear_Click" Margin="0,0,7,7"/>
            </WrapPanel>
          </Expander>
          <Expander Header="What gets recorded?" Foreground="#B7CADF" Padding="7">
            <StackPanel Margin="8,7,8,5">
              <TextBlock Text="Safe clicks, Enter, Tab, Escape and arrow keys. Ordinary typing, passwords, email addresses, MFA codes and sensitive forms are excluded."
                         TextWrapping="Wrap" Foreground="#BDD1E3"/>
              <TextBlock Text="Only the original LaunchFlow browser tab is recorded. Popup tabs, cross-origin frames and private URLs may need manual actions."
                         TextWrapping="Wrap" Foreground="#BDD1E3" Margin="0,6,0,0"/>
            </StackPanel>
          </Expander>
        </StackPanel>
      </Grid>
    </Border>
    <DockPanel Grid.Row="3" LastChildFill="False">
      <TextBlock Text="Review your actions before saving."
                 Foreground="#91AABE" FontSize="12" VerticalAlignment="Center"
                 DockPanel.Dock="Left"/>
      <Button x:Name="SaveStepsButton" Content="Save actions" Width="138" Height="38"
              Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"
              DockPanel.Dock="Right" Margin="8,0,0,0"/>
      <Button Content="Cancel" Width="100" Height="38" Click="Cancel_Click" DockPanel.Dock="Right"/>
    </DockPanel>
  </Grid>
</Window>
