<Window x:Class="LaunchFlow.VisualRecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teach LaunchFlow" Width="520" Height="460" MinWidth="455" MinHeight="365"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="True"
        Background="#111A2A" Foreground="#E9F1FB" FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Assets/LaunchFlow.ico" Closed="Window_Closed">
  <Grid Margin="20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Show LaunchFlow what to click" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="1. Switch to the original browser tab.  2. Click buttons and links to repeat.  3. Return here and choose Save clicks."
                 Margin="0,8,0,0" Foreground="#C3D5E7" TextWrapping="Wrap"/>
      <TextBlock Text="Only the original tab’s main page is supported. Form fields and typed text are excluded. Popup and frame clicks are not saved."
                 Margin="0,8,0,0" Foreground="#87DCD2" TextWrapping="Wrap"/>
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,14,0,8">
      <Button x:Name="CaptureToggle" Content="Pause recording" Style="{StaticResource PrimaryButton}"
              Click="ToggleCapture_Click" Margin="0,0,8,5" ToolTip="Recording starts automatically"/>
      <Button Content="Add current page" Click="CaptureUrl_Click" Margin="0,0,8,5"
              ToolTip="Remember the current website address as a step"/>
    </WrapPanel>
    <TextBlock Grid.Row="2" x:Name="CaptureStatus" Foreground="#6EE7D7" Margin="0,0,0,9" TextWrapping="Wrap"
               Text="Connecting to the browser…"/>
    <Grid Grid.Row="3">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ListBox x:Name="StepList" DisplayMemberPath="Description" Margin="0,0,0,8"
               AutomationProperties.Name="Recorded website clicks"/>
      <Expander Grid.Row="1" Header="More options (optional)" Foreground="#D5E8F8"
                Background="#1B2B3D" Margin="0,0,0,12" Padding="8">
        <WrapPanel Margin="4,7,4,2">
          <Button Content="Add a page" Click="AddNavigate_Click" Margin="0,0,6,6"/>
          <Button Content="Add a click" Click="AddClick_Click" Margin="0,0,6,6"/>
          <Button Content="Add a wait" Click="AddWait_Click" Margin="0,0,6,6"/>
          <Button Content="Remove selected" Click="Remove_Click" Margin="0,0,6,6"/>
          <Button Content="Clear clicks" Click="Clear_Click" Margin="0,0,6,6"/>
        </WrapPanel>
      </Expander>
    </Grid>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" Width="100" Height="38" Margin="0,0,10,0" Click="Cancel_Click"/>
      <Button x:Name="SaveStepsButton" Content="Save clicks" Width="125" Height="38"
              Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
