<Window x:Class="LaunchFlow.VisualRecorderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recording - LaunchFlow" Width="460" Height="640" MinWidth="400" MinHeight="480"
        WindowStartupLocation="Manual" ResizeMode="CanResize" ShowInTaskbar="True"
        Topmost="True" Background="#0D1725" Foreground="#EEF6FA" FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Assets/LaunchFlow.ico" Closed="Window_Closed">
  <Window.Resources>
    <Storyboard x:Key="RecordingPulse" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="RecordingDot"
                       Storyboard.TargetProperty="Opacity"
                       From="1" To="0.25" Duration="0:0:0.7" AutoReverse="True"/>
    </Storyboard>
  </Window.Resources>
  <Grid Margin="18,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Big recording cue so the user always knows capture is live -->
    <Border x:Name="RecordingBanner" Grid.Row="0" CornerRadius="10" Padding="14,12" Margin="0,0,0,12"
            Background="#3A1520" BorderBrush="#E0526A" BorderThickness="1.5">
      <DockPanel>
        <Ellipse x:Name="RecordingDot" Width="14" Height="14" Fill="#FF4D6A"
                 DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <StackPanel>
          <TextBlock x:Name="CaptureStatus" Text="RECORDING" FontSize="18" FontWeight="Bold"
                     Foreground="#FFE6EB"/>
          <TextBlock x:Name="TargetStatus" Text="Click in the browser LaunchFlow opened — not this window."
                     Foreground="#F0C4CC" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <StackPanel Grid.Row="1" Margin="0,0,0,10">
      <TextBlock Text="Your recorded clicks" FontSize="15" FontWeight="SemiBold" Foreground="#F4FAFF"/>
      <TextBlock Text="Keep this panel open while you click. Scroll here anytime. Passwords are never recorded."
                 Foreground="#AEC5D9" TextWrapping="Wrap" Margin="0,4,0,8" FontSize="12"/>
      <WrapPanel>
        <Button x:Name="CaptureToggle" Content="Pause" Style="{StaticResource PrimaryButton}"
                Click="ToggleCapture_Click" Margin="0,0,8,6" Padding="14,8"
                ToolTip="Pause or resume click capture"/>
        <Button Content="Add current page" Click="CaptureUrl_Click" Margin="0,0,8,6" Padding="12,8"
                ToolTip="Add a page-open step for the active browser tab"/>
        <Border Background="#214256" CornerRadius="12" Padding="10,5" Margin="0,0,0,6"
                VerticalAlignment="Center">
          <TextBlock x:Name="RecordedCountLabel" Text="0 clicks" Foreground="#A0EBDE"
                     FontWeight="SemiBold" FontSize="12"/>
        </Border>
      </WrapPanel>
    </StackPanel>

    <Border Grid.Row="2" Background="#111D2E" BorderBrush="#293D53" BorderThickness="1"
            CornerRadius="10" Padding="10" Margin="0,0,0,10">
      <Grid>
        <ListBox x:Name="StepList" DisplayMemberPath="DisplayLabel" SelectionMode="Extended"
                 MouseDoubleClick="EditSelected_Click" Padding="6" Background="#0D1725"
                 BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 AutomationProperties.Name="Recorded website clicks"/>
        <TextBlock x:Name="EmptyStepsHint"
                   Text="No clicks yet. Switch to the browser and click a button."
                   Foreground="#93ABBF" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                   IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center"
                   MaxWidth="300" Margin="12"/>
      </Grid>
    </Border>

    <WrapPanel Grid.Row="3" Margin="0,0,0,10">
      <Button Content="Select all" Click="SelectAll_Click" Margin="0,0,7,7" Padding="10,7"/>
      <Button Content="Delete selected" Click="Remove_Click" Margin="0,0,7,7" Padding="10,7"/>
      <Button Content="Edit" Click="EditSelected_Click" Margin="0,0,7,7" Padding="10,7"/>
      <Button Content="Wait +1s" Click="QuickWait_Click" Margin="0,0,7,7" Padding="10,7"/>
      <Button Content="Clear all" Click="Clear_Click" Margin="0,0,7,7" Padding="10,7"/>
      <Button Content="+ Page" Click="AddNavigate_Click" Margin="0,0,7,7" Padding="10,7"/>
      <Button Content="+ Click" Click="AddClick_Click" Margin="0,0,7,7" Padding="10,7"/>
      <Button Content="+ Wait" Click="AddWait_Click" Margin="0,0,7,7" Padding="10,7"/>
    </WrapPanel>

    <DockPanel Grid.Row="4" LastChildFill="False">
      <TextBlock Text="Done clicking? Save below."
                 Foreground="#91AABE" FontSize="12" VerticalAlignment="Center"
                 DockPanel.Dock="Left"/>
      <Button x:Name="SaveStepsButton" Content="Save" Width="110" Height="36"
              Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click"
              DockPanel.Dock="Right" Margin="8,0,0,0"/>
      <Button Content="Cancel" Width="90" Height="36" Click="Cancel_Click" DockPanel.Dock="Right"/>
    </DockPanel>
  </Grid>
</Window>
