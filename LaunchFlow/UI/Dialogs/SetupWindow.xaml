<Window x:Class="LaunchFlow.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up LaunchFlow" Width="560" Height="600" MinWidth="520" MinHeight="560"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#111A2A" Foreground="#E9F1FB" FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Assets/LaunchFlow.ico">
  <Grid Margin="28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <Image Source="pack://application:,,,/Assets/LaunchFlow.png" Width="40" Height="40" Margin="0,0,12,0"/>
        <TextBlock Text="LaunchFlow" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="Create a master password for your local encrypted vault. Workflows and saved logins stay on this PC — nothing is uploaded."
                 Margin="0,4,0,0" Foreground="#A8BED6" TextWrapping="Wrap" LineHeight="20"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,22,0,0">
      <TextBlock Text="Master password" FontWeight="SemiBold"/>
      <PasswordBox x:Name="PasswordBox" Margin="0,8,0,6" Height="36" Background="#0D1522"
                   Foreground="White" BorderBrush="#354358" Padding="10,8"
                   PasswordChanged="PasswordBox_PasswordChanged"/>
      <TextBlock x:Name="StrengthLabel" Text="Strength: —" Foreground="#6EE7D7" Margin="0,0,0,4"/>
      <TextBlock x:Name="StrengthHint" Text="Use a long passphrase you will remember. It cannot be recovered if forgotten."
                 Foreground="#91A1B7" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBlock Text="Confirm master password" FontWeight="SemiBold"/>
      <PasswordBox x:Name="ConfirmBox" Margin="0,8,0,0" Height="36" Background="#0D1522"
                   Foreground="White" BorderBrush="#354358" Padding="10,8"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="0,22,0,0">
      <TextBlock Text="How LaunchFlow should behave" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <CheckBox x:Name="StartupCheck" Content="Start with Windows (hidden in the tray)" IsChecked="True" Margin="0,0,0,6"/>
      <CheckBox x:Name="UnlockCheck" Content="Run my workflows after I unlock Windows" IsChecked="True" Margin="0,0,0,6"/>
      <CheckBox x:Name="LaunchCheck" Content="Run my workflows when LaunchFlow opens" Margin="0,0,0,6"/>
      <CheckBox x:Name="TrayCheck" Content="Keep running in the system tray when I close the window" IsChecked="True"/>
    </StackPanel>
    <DockPanel Grid.Row="3" Margin="0,16,0,0">
      <Button DockPanel.Dock="Left" Content="Cancel" Width="100" Height="38" IsCancel="True" Click="Cancel_Click"/>
      <Button DockPanel.Dock="Right" Content="Create vault &amp; continue" MinWidth="180" Height="38"
              Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
              IsDefault="True" Click="Create_Click" Padding="16,0"/>
    </DockPanel>
  </Grid>
</Window>
