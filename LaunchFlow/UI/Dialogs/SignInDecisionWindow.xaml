<Window x:Class="LaunchFlow.SignInDecisionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick check" Width="560" Height="340" MinWidth="460" MinHeight="280"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#111A2A" Foreground="#E9F1FB" FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Assets/LaunchFlow.ico">
    <Grid Margin="22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock x:Name="WebsiteTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Text="Quick check"/>
        <TextBlock Text="No rush. Glance at the browser window — if you’re already signed in, say so. Otherwise you can try again later."
                   Foreground="#A8BED6" Margin="0,12,0,7" TextWrapping="Wrap"/>
      </StackPanel>
      <ScrollViewer Grid.Row="1" Margin="0,10,0,14" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <TextBlock x:Name="ReasonText" Foreground="#C3D5E7"
                   TextWrapping="Wrap"/>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="OK, later" Width="100" Margin="0,0,8,0" Click="Later_Click"/>
        <Button Content="Fix sign-in" Width="100" Margin="0,0,8,0" Click="Repair_Click"/>
        <Button Content="I'm signed in" Width="120" Style="{StaticResource PrimaryButton}" Click="Confirmed_Click"/>
      </StackPanel>
    </Grid>
</Window>
