<Window x:Class="LaunchFlow.PasswordOriginApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm password website" Width="520" Height="340" MinWidth="460"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Topmost="True" ShowActivated="True" ShowInTaskbar="True"
        Background="#111A2A" Foreground="#E9F1FB" FontFamily="Segoe UI" FontSize="13"
        Icon="pack://application:,,,/Assets/LaunchFlow.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Approve this password website?" FontSize="20"
                       FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="WebsiteText" Foreground="#AEC4D9" FontSize="13"
                       Margin="0,10,0,4" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,12,0,12">
            <TextBlock Text="LaunchFlow reached a different website for the password step:"
                       TextWrapping="Wrap" Foreground="#BDCEE0"/>
            <Border Background="#1C2A3D" CornerRadius="6" Padding="12" Margin="0,10">
                <TextBlock x:Name="OriginText" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="#F2F7FF" FontSize="15"/>
            </Border>
            <TextBlock Text="Allow your saved password only if you recognize this sign-in address. Choosing Cancel will not type the password."
                       TextWrapping="Wrap" Foreground="#D4BCA7"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="110" Height="37" Margin="0,0,10,0"
                    Click="Cancel_Click" IsDefault="True" IsCancel="True"/>
            <Button x:Name="ApproveButton" Content="Allow password on this site"
                    Width="220" Height="37" Style="{StaticResource PrimaryButton}"
                    Click="Approve_Click"/>
        </StackPanel>
    </Grid>
</Window>
