<Window x:Class="LaunchFlow.VaultFreshStartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preserve existing files and start fresh" Width="580" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#111A2A" Foreground="#E9F1FB" FontFamily="Segoe UI" FontSize="13">
  <StackPanel Margin="28">
    <TextBlock Text="This does not recover your existing vault" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Margin="0,14,0,16" TextWrapping="Wrap" LineHeight="21"
               Text="LaunchFlow will move the incomplete or unrecognized database and its WAL/SHM companions into a unique recovery location without overwriting other files. A new empty vault can then be set up. Nothing is deleted. Retain the preserved set for recovery; the new password cannot open it. Recognized vaults cannot use this option."/>
    <CheckBox x:Name="PreserveCheck" Margin="0,0,0,16">
      <TextBlock Text="I understand this preserves files, not their recoverability, and starts a separate empty vault." TextWrapping="Wrap"/>
    </CheckBox>
    <TextBlock Text="Type START NEW VAULT exactly (not a password):"/>
    <TextBox x:Name="ConfirmationText" Margin="0,8,0,20" Height="34" Padding="8,5"
             Background="#0D1522" Foreground="White" BorderBrush="#354358"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel — keep files in place" IsCancel="True" Click="Cancel_Click" Padding="12,8" Margin="0,0,10,0"/>
      <Button Content="Preserve files and continue" Click="Confirm_Click" Padding="12,8"/>
    </StackPanel>
  </StackPanel>
</Window>
