<Window x:Class="LaunchFlow.TutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LaunchFlow — Getting started" Width="565" Height="430"
        MinWidth="520" MinHeight="385" WindowStartupLocation="CenterOwner"
        Background="#111A2A" Foreground="#E9F1FB" FontFamily="Segoe UI" FontSize="14"
        Icon="pack://application:,,,/Assets/LaunchFlow.ico">
  <Grid Margin="28,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Welcome to LaunchFlow" FontSize="23" FontWeight="SemiBold"/>
      <TextBlock x:Name="ProgressLabel" Text="Step 1 of 4" Margin="0,8,0,0" Foreground="#6EE7D7"/>
    </StackPanel>
    <StackPanel Grid.Row="1" VerticalAlignment="Center">
      <TextBlock x:Name="StepHeading" Text="Add your first website" FontSize="21" FontWeight="SemiBold"
                 Margin="0,0,0,18" TextWrapping="Wrap"/>
      <TextBlock x:Name="StepDetails" FontSize="15" Foreground="#C4D6E9"
                 TextWrapping="Wrap" LineHeight="25"/>
    </StackPanel>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="You can reopen this guide anytime with Help." Foreground="#A1B9CE"
                 FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="BackButton" Content="Back" Width="88" Height="38" Click="Back_Click"/>
        <Button x:Name="NextButton" Content="Next" Width="92" Height="38"
                Style="{StaticResource PrimaryButton}" Click="Next_Click" Margin="4,0,0,0" IsDefault="True"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
