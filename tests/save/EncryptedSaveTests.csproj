<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../LaunchFlow/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../../LaunchFlow/Services/EnterprisePolicy.cs" Link="Services/EnterprisePolicy.cs" />
    <Compile Include="../../LaunchFlow/Services/VaultDatabase.cs" Link="Services/VaultDatabase.cs" />
    <Compile Include="../../LaunchFlow/Services/ConfigStore.cs" Link="Services/ConfigStore.cs" />
    <Compile Include="../../LaunchFlow/Services/PasswordStrength.cs" Link="Services/PasswordStrength.cs" />
    <Compile Include="../../LaunchFlow/Services/WorkflowConfigurationService.cs" Link="Services/WorkflowConfigurationService.cs" />
    <Compile Include="../../LaunchFlow/Services/WebsiteLoginMode.cs" Link="Services/WebsiteLoginMode.cs" />
    <Compile Include="../../LaunchFlow/Services/ConfigurationSaveTransaction.cs" Link="Services/ConfigurationSaveTransaction.cs" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>
</Project>
