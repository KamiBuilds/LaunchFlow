    <Compile Include="../../LaunchFlow/Services/Persistence/AutoSaveSchedule.cs" Link="Services/AutoSaveSchedule.cs" />
    <Compile Include="../../LaunchFlow/Services/Persistence/ConfigurationSaveTransaction.cs" Link="Services/ConfigurationSaveTransaction.cs" />
    <Compile Include="../../LaunchFlow/Services/Login/WebsiteLoginMode.cs" Link="Services/WebsiteLoginMode.cs" />
    <Compile Include="../../LaunchFlow/Services/Workspaces/RunOutcomeSummary.cs" Link="Services/RunOutcomeSummary.cs" />
    <Compile Include="../../LaunchFlow/Services/Vault/PasswordSessionPolicy.cs" Link="Services/PasswordSessionPolicy.cs" />
  </ItemGroup>
</Project>
