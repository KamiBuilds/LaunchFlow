<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <Target Name="ExtractRecoveryHandler" BeforeTargets="BeforeCompile">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/extract.py&quot; &quot;$(MSBuildProjectDirectory)/obj/App.Recovery.g.cs&quot; $(RecoveryHandlerSource)" />
  </Target>
  <ItemGroup>
    <Compile Include="obj/App.Recovery.g.cs" />
    <Compile Include="obj/MainWindow.Master.g.cs" />
    <Compile Include="../../LaunchFlow/Services/Vault/MasterPasswordService.cs" Link="Production/MasterPasswordService.cs" />
    <Compile Include="../../LaunchFlow/Services/Persistence/ImportConfigurationProjection.cs" Link="Production/ImportConfigurationProjection.cs" />
    <Compile Include="../../LaunchFlow/App.VaultRecovery.cs" Link="Production/App.VaultRecovery.cs" Condition="Exists('../../LaunchFlow/App.VaultRecovery.cs')" />
    <Compile Include="../../LaunchFlow/UI/Dialogs/VaultRecoveryWindow.xaml.cs" Link="Production/VaultRecoveryWindow.xaml.cs" Condition="Exists('../../LaunchFlow/UI/Dialogs/VaultRecoveryWindow.xaml.cs')" />
    <Compile Include="../../LaunchFlow/UI/Dialogs/VaultFreshStartWindow.xaml.cs" Link="Production/VaultFreshStartWindow.xaml.cs" Condition="Exists('../../LaunchFlow/UI/Dialogs/VaultFreshStartWindow.xaml.cs')" />
    <Compile Include="../../LaunchFlow/App.VaultSetup.cs" Link="Production/App.VaultSetup.cs" />
    <Compile Include="../../LaunchFlow/Services/Platform/StartupDiagnostics.cs" Link="Production/StartupDiagnostics.cs" />
    <Compile Include="../../LaunchFlow/Domain/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../../LaunchFlow/Services/Policy/EnterprisePolicy.cs" Link="Services/EnterprisePolicy.cs" />
    <Compile Include="../../LaunchFlow/Services/Vault/VaultDatabase.cs" Link="Services/VaultDatabase.cs" />
    <Compile Include="../../LaunchFlow/Services/Vault/VaultDatabase.Strict.cs" Link="Services/VaultDatabase.Strict.cs" />
    <Compile Include="../../LaunchFlow/Services/Vault/VaultDatabase.Upgrade.cs" Link="Services/VaultDatabase.Upgrade.cs" />
    <Compile Include="../../LaunchFlow/Services/Vault/VaultRecordCodec.cs" Link="Services/VaultRecordCodec.cs" />
    <Compile Include="../../LaunchFlow/Services/Persistence/ConfigStore.cs" Link="Services/ConfigStore.cs" />
    <Compile Include="../../LaunchFlow/Services/Vault/PasswordStrength.cs" Link="Services/PasswordStrength.cs" />
    <Compile Include="../../LaunchFlow/Services/Persistence/WorkflowConfigurationService.cs" Link="Services/WorkflowConfigurationService.cs" />
    <Compile Include="../../LaunchFlow/Services/Login/WebsiteLoginMode.cs" Link="Services/WebsiteLoginMode.cs" />
    <Compile Include="../../LaunchFlow/Services/Persistence/ConfigurationSaveTransaction.cs" Link="Services/ConfigurationSaveTransaction.cs" />
    <Compile Include="../../LaunchFlow/Services/Vault/CredentialVault.cs" Link="Services/CredentialVault.cs" />
    <Compile Include="../../LaunchFlow/Services/Vault/VaultRecoveryService.cs" Link="Services/VaultRecoveryService.cs" />
    <Compile Include="../../LaunchFlow/Services/Vault/VaultRestoreFileOperations.cs" Link="Services/VaultRestoreFileOperations.cs" />
    <Compile Include="../../LaunchFlow/Services/Diagnostics/CrashLog.cs" Link="Services/CrashLog.cs" />
    <Compile Include="../../LaunchFlow/Services/KeePass/KeePassXcService.cs" Link="Services/KeePassXcService.cs" />
    <Compile Include="../../LaunchFlow/Services/Transfer/PortableExport.cs" Link="Services/PortableExport.cs" />
    <Compile Include="../../LaunchFlow/Services/Transfer/PortableImportValidation.cs" Link="Services/PortableImportValidation.cs" />
    <Compile Include="../../LaunchFlow/Services/Transfer/SecureTransferService.cs" Link="Services/SecureTransferService.cs" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>
</Project>
