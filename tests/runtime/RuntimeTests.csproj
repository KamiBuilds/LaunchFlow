<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AutomationEngineSource Condition="'$(AutomationEngineSource)' == ''">../../LaunchFlow/Services/Automation/AutomationEngine.cs</AutomationEngineSource>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
    <Compile Include="$(AutomationEngineSource)" Link="AutomationEngine.cs" />
    <!-- When testing the current engine, include every production partial.
         Compatibility baselines supplied by AutomationEngineSource remain isolated. -->
    <Compile Include="../../LaunchFlow/Services/Automation/AutomationEngine.*.cs" Link="Services/%(Filename)%(Extension)" Condition="'$(AutomationEngineSource)' == '../../LaunchFlow/Services/Automation/AutomationEngine.cs'" />
    <Compile Include="../../LaunchFlow/Services/Browser/BrowserInstallations.cs" Link="Services/BrowserInstallations.cs" />
    <Compile Include="../../LaunchFlow/Services/Browser/PlaywrightFirefoxSupport.cs" Link="Services/PlaywrightFirefoxSupport.cs" />
    <Compile Include="../../LaunchFlow/Services/Policy/EnterprisePolicy.cs" Link="EnterprisePolicy.cs" />
    <Compile Include="../../LaunchFlow/Services/Browser/MonitorService.cs" Link="MonitorService.cs" />
    <Compile Include="../../LaunchFlow/Services/Vault/ProfileVaultService.cs" Link="ProfileVaultService.cs" />
    <Compile Include="../profiles/PlatformStubs.cs" Link="ProfilePlatformStubs.cs" />
    <Compile Include="../../LaunchFlow/Services/Login/LoginHealth.cs" Link="LoginHealth.cs" />
    <Compile Include="../../LaunchFlow/Services/Login/LoginRecipe.cs" Link="LoginRecipe.cs" Condition="'$(AutomationEngineSource)' == '../../LaunchFlow/Services/Automation/AutomationEngine.cs'" />
    <Compile Include="../../LaunchFlow/Services/Workspaces/RunIssueNotice.cs" Link="RunIssueNotice.cs" />
    <Compile Include="../../LaunchFlow/Services/Login/LoginFieldDiscovery.cs" Link="LoginFieldDiscovery.cs" Condition="'$(AutomationEngineSource)' == '../../LaunchFlow/Services/Automation/AutomationEngine.cs'" />
    <Compile Include="../../LaunchFlow/Services/Login/LoginCompletionObserver.cs" Link="Services/LoginCompletionObserver.cs" Condition="'$(AutomationEngineSource)' == '../../LaunchFlow/Services/Automation/AutomationEngine.cs'" />
    <Compile Include="../../LaunchFlow/Services/Login/LoginFlowCoordinator.cs" Link="Services/LoginFlowCoordinator.cs" Condition="'$(AutomationEngineSource)' == '../../LaunchFlow/Services/Automation/AutomationEngine.cs'" />
    <Compile Include="../../LaunchFlow/Services/KeePass/KeePassXcService.cs" Link="KeePassXcService.cs" />
    <Compile Include="../../LaunchFlow/Domain/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
