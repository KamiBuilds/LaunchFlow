<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AutomationEngineSource Condition="'$(AutomationEngineSource)' == ''">../../LaunchFlow/Services/AutomationEngine.cs</AutomationEngineSource>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
    <Compile Include="$(AutomationEngineSource)" Link="AutomationEngine.cs" />
    <!-- When testing the current engine, include every production partial.
         Compatibility baselines supplied by AutomationEngineSource remain isolated. -->
    <Compile Include="../../LaunchFlow/Services/AutomationEngine.*.cs" Link="Services/%(Filename)%(Extension)" Condition="'$(AutomationEngineSource)' == '../../LaunchFlow/Services/AutomationEngine.cs'" />
    <Compile Include="../../LaunchFlow/Services/BrowserInstallations.cs" Link="Services/BrowserInstallations.cs" />
    <Compile Include="../../LaunchFlow/Services/EnterprisePolicy.cs" Link="EnterprisePolicy.cs" />
    <Compile Include="../../LaunchFlow/Services/MonitorService.cs" Link="MonitorService.cs" />
    <Compile Include="../../LaunchFlow/Services/ProfileVaultService.cs" Link="ProfileVaultService.cs" />
    <Compile Include="../profiles/PlatformStubs.cs" Link="ProfilePlatformStubs.cs" />
    <Compile Include="../../LaunchFlow/Services/LoginHealth.cs" Link="LoginHealth.cs" />
    <Compile Include="../../LaunchFlow/Services/KeePassXcService.cs" Link="KeePassXcService.cs" />
    <Compile Include="../../LaunchFlow/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
