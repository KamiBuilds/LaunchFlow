<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);LEGACY_COMPAT</DefineConstants>
  </PropertyGroup>
  <Target Name="ValidatePinnedLegacyInputs" BeforeTargets="CoreCompile">
    <Error Condition="'$(VaultDatabaseSource)' == ''" Text="Pinned legacy VaultDatabaseSource is required." />
    <Error Condition="'$(LegacyConfigStoreSource)' == ''" Text="Pinned legacy ConfigStoreSource is required." />
    <Error Condition="'$(LegacyCredentialVaultSource)' == ''" Text="Pinned legacy credential facade source is required." />
    <Error Condition="'$(LegacyTransferSource)' == ''" Text="Pinned legacy transfer service source is required." />
    <Error Condition="!Exists('$(VaultDatabaseSource)')" Text="Pinned legacy VaultDatabase source does not exist." />
    <Error Condition="!Exists('$(LegacyConfigStoreSource)')" Text="Pinned legacy ConfigStore source does not exist." />
    <Error Condition="!Exists('$(LegacyCredentialVaultSource)')" Text="Pinned credential facade source does not exist." />
    <Error Condition="!Exists('$(LegacyTransferSource)')" Text="Pinned transfer service source does not exist." />
  </Target>
  <ItemGroup>
    <Compile Include="LegacyCompatibilityProgram.cs" />
    <Compile Include="PlatformStubs.cs" />
    <Compile Include="CompatibilityTests.cs" />
    <Compile Include="../../LaunchFlow/Domain/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../../LaunchFlow/Services/Policy/EnterprisePolicy.cs" Link="EnterprisePolicy.cs" />
    <Compile Include="../../LaunchFlow/Services/Diagnostics/CrashLog.cs" Link="CrashLog.cs" />
    <Compile Include="$(VaultDatabaseSource)" Link="VaultDatabase.cs" />
    <Compile Include="$(LegacyConfigStoreSource)" Link="ConfigStore.cs" />
    <Compile Include="$(LegacyCredentialVaultSource)" Link="CredentialVault.cs" />
    <Compile Include="$(LegacyTransferSource)" Link="SecureTransferService.cs" />
    <Compile Include="../../LaunchFlow/Services/Transfer/PortableExport.cs" Link="PortableExport.cs" />
    <Compile Include="../../LaunchFlow/Services/Vault/PasswordStrength.cs" Link="PasswordStrength.cs" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>
</Project>
