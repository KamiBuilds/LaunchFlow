<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <VaultDatabaseSource Condition="'$(VaultDatabaseSource)' == ''">../../LaunchFlow/Services/VaultDatabase.cs</VaultDatabaseSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../LaunchFlow/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../../LaunchFlow/Services/EnterprisePolicy.cs" Link="EnterprisePolicy.cs" Condition="Exists('../../LaunchFlow/Services/EnterprisePolicy.cs')" />
    <Compile Include="../../LaunchFlow/Services/CrashLog.cs" Link="CrashLog.cs" />
    <Compile Include="$(VaultDatabaseSource)" Link="VaultDatabase.cs" />
    <Compile Include="../../LaunchFlow/Services/CredentialVault.cs" Link="CredentialVault.cs" />
    <Compile Include="../../LaunchFlow/Services/ConfigStore.cs" Link="ConfigStore.cs" />
    <Compile Include="../../LaunchFlow/Services/SecureTransferService.cs" Link="SecureTransferService.cs" />
    <Compile Include="../../LaunchFlow/Services/PortableExport.cs" Link="PortableExport.cs" />
    <Compile Include="../../LaunchFlow/Services/PasswordStrength.cs" Link="PasswordStrength.cs" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>
</Project>
