<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <VaultDatabaseSource Condition="'$(VaultDatabaseSource)' == ''">../../LaunchFlow/Services/Vault/VaultDatabase.cs</VaultDatabaseSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="LegacyCompatibilityProgram.cs" />
    <Compile Include="../../LaunchFlow/Domain/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../../LaunchFlow/Services/Policy/EnterprisePolicy.cs" Link="EnterprisePolicy.cs" Condition="Exists('../../LaunchFlow/Services/Policy/EnterprisePolicy.cs')" />
    <Compile Include="../../LaunchFlow/Services/Diagnostics/CrashLog.cs" Link="CrashLog.cs" />
    <Compile Include="$(VaultDatabaseSource)" Link="VaultDatabase.cs" />
    <Compile Include="../../LaunchFlow/Services/Vault/VaultDatabase.Strict.cs" Link="Services/VaultDatabase.Strict.cs" />
    <Compile Include="../../LaunchFlow/Services/Vault/VaultDatabase.Upgrade.cs" Link="Services/VaultDatabase.Upgrade.cs" />
    <Compile Include="../../LaunchFlow/Services/Vault/VaultRecordCodec.cs" Link="Services/VaultRecordCodec.cs" />
    <Compile Include="../../LaunchFlow/Services/Vault/CredentialVault.cs" Link="CredentialVault.cs" />
    <Compile Include="../../LaunchFlow/Services/Persistence/ConfigStore.cs" Link="ConfigStore.cs" />
    <Compile Include="../../LaunchFlow/Services/Transfer/SecureTransferService.cs" Link="SecureTransferService.cs" />
    <Compile Include="../../LaunchFlow/Services/Transfer/PortableImportValidation.cs" Link="PortableImportValidation.cs" />
    <Compile Include="../../LaunchFlow/Services/Transfer/PortableExport.cs" Link="PortableExport.cs" />
    <Compile Include="../../LaunchFlow/Services/Vault/PasswordStrength.cs" Link="PasswordStrength.cs" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>
</Project>
