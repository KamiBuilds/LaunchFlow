<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LaunchFlowSourceRoot Condition="'$(LaunchFlowSourceRoot)' == ''">$(MSBuildThisFileDirectory)../..</LaunchFlowSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(LaunchFlowSourceRoot)/LaunchFlow/Domain/Models/*.cs" Link="Production/Models/%(Filename)%(Extension)" />
    <Compile Include="$(LaunchFlowSourceRoot)/LaunchFlow/Services/Vault/VaultDatabase*.cs" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="$(LaunchFlowSourceRoot)/LaunchFlow/Services/Vault/VaultRecordCodec.cs" Link="Production/VaultRecordCodec.cs" />
    <Compile Include="$(LaunchFlowSourceRoot)/LaunchFlow/Services/Vault/PasswordStrength.cs" Link="Production/PasswordStrength.cs" />
    <Compile Include="$(LaunchFlowSourceRoot)/LaunchFlow/Services/Vault/CredentialVault.cs" Link="Production/CredentialVault.cs" />
    <Compile Include="$(LaunchFlowSourceRoot)/LaunchFlow/Services/Vault/VaultRecoveryService.cs" Link="Production/VaultRecoveryService.cs" />
    <Compile Include="$(LaunchFlowSourceRoot)/LaunchFlow/Services/Vault/VaultRestoreFileOperations.cs" Link="Production/VaultRestoreFileOperations.cs" />
    <Compile Include="$(LaunchFlowSourceRoot)/LaunchFlow/Services/Policy/EnterprisePolicy.cs" Link="Production/EnterprisePolicy.cs" />
    <Compile Include="$(LaunchFlowSourceRoot)/LaunchFlow/Services/Transfer/Portable*.cs" Link="Production/%(Filename)%(Extension)" />
    <Compile Include="$(LaunchFlowSourceRoot)/LaunchFlow/Services/Transfer/SecureTransferService.cs" Link="Production/SecureTransferService.cs" />
    <Compile Include="$(LaunchFlowSourceRoot)/LaunchFlow/Services/Persistence/ConfigStore.cs" Link="Production/ConfigStore.cs" />
    <Compile Include="$(LaunchFlowSourceRoot)/LaunchFlow/Services/Persistence/WorkflowConfigurationService.cs" Link="Production/WorkflowConfigurationService.cs" />
    <Compile Include="$(LaunchFlowSourceRoot)/LaunchFlow/Services/Login/WebsiteLoginMode.cs" Link="Production/WebsiteLoginMode.cs" />
    <Compile Include="$(LaunchFlowSourceRoot)/LaunchFlow/Services/KeePass/KeePassXcService.cs" Link="Production/KeePassXcService.cs" />
    <Compile Include="$(LaunchFlowSourceRoot)/LaunchFlow/Services/Diagnostics/CrashLog.cs" Link="Production/CrashLog.cs" />
    <Compile Include="$(LaunchFlowSourceRoot)/LaunchFlow/Services/Platform/StartupDiagnostics.cs" Link="Production/StartupDiagnostics.cs" />
    <Compile Include="$(LaunchFlowSourceRoot)/LaunchFlow/UI/Dialogs/SetupWindow.xaml.cs" Link="Production/SetupWindow.xaml.cs" />
    <Compile Include="$(LaunchFlowSourceRoot)/LaunchFlow/UI/Dialogs/SecretPromptWindow.xaml.cs" Link="Production/SecretPromptWindow.xaml.cs" />
    <Compile Include="$(LaunchFlowSourceRoot)/tests/setup-validation/SetupWindowAdapters.cs" Link="Adapters/SetupWindowAdapters.cs" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>
</Project>
